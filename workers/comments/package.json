{
  "name": "blog-comments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "留心博客的评论后端（Cloudflare Workers + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute blog-comments --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute blog-comments --local --file=./schema.sql",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
