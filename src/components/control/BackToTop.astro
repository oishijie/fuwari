<script is:raw is:inline>
(function () {
    // ===== 回顶部 =====
    function toolbarBackToTop() {
        window.scroll({ top: 0, behavior: 'smooth' });
    }
    window.toolbarBackToTop = toolbarBackToTop;
    window.backToTop = toolbarBackToTop; // 兼容旧调用名

    // ===== 随机一篇文章 =====
    function toolbarRandomPost() {
        var btn = document.getElementById('random-post-btn');
        if (!btn) return;

        var urls = [];
        try {
            urls = JSON.parse(btn.getAttribute('data-post-urls') || '[]');
        } catch (e) {
            urls = [];
        }
        if (!Array.isArray(urls) || urls.length === 0) return;

        // 尽量不随机到当前正在读的这篇
        var here = window.location.pathname;
        var pool = urls.filter(function (u) { return u !== here; });
        if (pool.length === 0) pool = urls;

        var target = pool[Math.floor(Math.random() * pool.length)];

        // 走 Swup 无刷新跳转，失败则退化为普通跳转
        if (window.swup && typeof window.swup.navigate === 'function') {
            window.swup.navigate(target);
        } else if (window.swup && typeof window.swup.loadPage === 'function') {
            window.swup.loadPage({ url: target });
        } else {
            window.location.href = target;
        }
    }
    window.toolbarRandomPost = toolbarRandomPost;

    // ===== 判断当前是否为文章页 =====
    function isPostPage() {
        return window.location.pathname.indexOf('/posts/') === 0
            || window.location.pathname === '/posts';
    }

    // ===== 根据当前 URL + 评论是否存在，更新目录/评论按钮可见性 =====
    function updateTocBtnVisibility() {
        const isPost = isPostPage();

        // 目录按钮：仅文章页
        const tocBtn = document.getElementById('show-toc-btn');
        if (tocBtn) tocBtn.style.display = isPost ? '' : 'none';

        // 评论按钮：仅文章页 + 页面存在 #post-comment 锚点
        const commentBtn = document.getElementById('goto-comment-btn');
        const commentEl = document.getElementById('post-comment');
        const hasComment = !!commentEl && commentEl.children.length > 0;
        if (commentBtn) commentBtn.style.display = (isPost && hasComment) ? '' : 'none';
    }

    // ===== 跳转评论区 =====
    function toolbarGotoComment() {
        const target = document.getElementById('post-comment');
        if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }
    window.toolbarGotoComment = toolbarGotoComment;

    // ===== 目录弹窗（复刻 msqy.cc.cd 的 .toc-popup） =====
    // 层级不用克隆后的类名（ml-4 / ml-8）反推，直接读对应 heading 的标签名——
    // 加密文章解密后重建目录时同样成立。
    function headingDepthOf(href) {
        var id = decodeURIComponent((href || '').replace(/^#/, ''));
        if (!id) return null;
        var el = document.getElementById(id);
        if (!el) return null;
        var n = Number(el.tagName.charAt(1));
        return n >= 1 && n <= 6 ? n : null;
    }

    function populatePopup() {
        var nav = document.getElementById('toc-popup-nav');
        if (!nav) return;

        // 清旧条目，但保留 indicator（它由 CSS + 脚本定位）
        Array.prototype.slice.call(nav.querySelectorAll('.toc-popup-item, .toc-popup-empty'))
            .forEach(function (el) { el.parentNode.removeChild(el); });

        var links = Array.prototype.slice.call(
            document.querySelectorAll('#toc table-of-contents > a')
        );
        if (!links.length) {
            var empty = document.createElement('div');
            empty.className = 'toc-popup-empty text-50';
            empty.textContent = '本文无目录';
            nav.appendChild(empty);
            return;
        }

        var raw = [];
        var minDepth = 10;
        links.forEach(function (a) {
            var href = a.getAttribute('href') || '';
            var d = headingDepthOf(href);
            if (d === null) return;
            if (d < minDepth) minDepth = d;
            raw.push({ href: href, depth: d, text: (a.textContent || '').trim() });
        });

        var h1Count = 1;
        raw.forEach(function (it) {
            var level = Math.min(Math.max(it.depth - minDepth, 0), 2);

            var a = document.createElement('a');
            a.className = 'toc-popup-item toc-level-' + level;
            a.setAttribute('href', it.href);

            var badge = document.createElement('span');
            badge.className = 'toc-popup-badge';
            if (level === 0) {
                var idx = document.createElement('span');
                idx.className = 'toc-badge-index';
                idx.textContent = String(h1Count++);
                badge.appendChild(idx);
            } else {
                var dot = document.createElement('span');
                dot.className = level === 1 ? 'toc-badge-dot' : 'toc-badge-dot-sm';
                badge.appendChild(dot);
            }

            var label = document.createElement('span');
            label.className = 'toc-popup-label ' + (level === 0 ? 'label-primary text-75' : 'text-50');
            // 用 textContent 而不是 innerHTML：标题来自文章，天然免转义
            label.textContent = it.text;

            a.appendChild(badge);
            a.appendChild(label);
            nav.appendChild(a);
        });
    }

    // ===== 当前小节高亮：只在弹窗打开时跑，共用滚动回调，不额外加监听 =====
    function syncActiveItem() {
        var popup = document.getElementById('toc-popup');
        var nav = document.getElementById('toc-popup-nav');
        var indicator = document.getElementById('toc-popup-indicator');
        if (!popup || !nav || !popup.classList.contains('is-open')) return;

        var items = Array.prototype.slice.call(nav.querySelectorAll('.toc-popup-item'));
        if (!items.length) return;

        // 视口顶部往下 120px 作为判定线
        var probe = 120;
        var current = 0;
        for (var i = 0; i < items.length; i++) {
            var id = decodeURIComponent((items[i].getAttribute('href') || '').replace(/^#/, ''));
            var h = document.getElementById(id);
            if (!h) continue;
            if (h.getBoundingClientRect().top <= probe) current = i;
            else break;
        }

        items.forEach(function (el, i) {
            el.classList.toggle('visible', i === current);
        });

        var cur = items[current];
        if (indicator) {
            indicator.style.opacity = '1';
            // indicator 与 item 的 offsetParent 都是 #toc-popup-nav，坐标同口径
            indicator.style.top = cur.offsetTop + 'px';
            indicator.style.height = cur.offsetHeight + 'px';
        }

        // 当前项滚出弹窗可视区时带回来（nav 有 padding，用 popup 的滚动量比较）
        var itemTop = nav.offsetTop + cur.offsetTop;
        if (itemTop < popup.scrollTop || itemTop + cur.offsetHeight > popup.scrollTop + popup.clientHeight) {
            popup.scrollTo({
                top: Math.max(0, itemTop - popup.clientHeight / 2),
                behavior: 'smooth',
            });
        }
    }

    function clearActiveItem() {
        var nav = document.getElementById('toc-popup-nav');
        var indicator = document.getElementById('toc-popup-indicator');
        if (nav) {
            Array.prototype.slice.call(nav.querySelectorAll('.toc-popup-item'))
                .forEach(function (el) { el.classList.remove('visible'); });
        }
        if (indicator) indicator.style.opacity = '0';
    }

    // ===== 打开 / 关闭目录弹窗 =====
    function toolbarToggleToc() {
        var popup = document.getElementById('toc-popup');
        if (!popup) return;
        if (popup.classList.contains('is-open')) {
            toolbarCloseToc();
            return;
        }
        populatePopup(); // 每次打开前重建，保证和当前文章一致
        popup.classList.add('is-open');
        popup.setAttribute('aria-hidden', 'false');
        var btn = document.getElementById('show-toc-btn');
        if (btn) btn.classList.add('is-open');
        requestAnimationFrame(syncActiveItem);
    }
    window.toolbarToggleToc = toolbarToggleToc;

    function toolbarCloseToc() {
        var popup = document.getElementById('toc-popup');
        if (!popup) return;
        popup.classList.remove('is-open');
        popup.setAttribute('aria-hidden', 'true');
        var btn = document.getElementById('show-toc-btn');
        if (btn) btn.classList.remove('is-open');
        clearActiveItem();
    }

    // ===== 回顶部按钮上的阅读进度环（复刻 msqy.cc.cd 的 .progress-ring） =====
    // 环是正圆，周长 = 2πr。数值必须和模板里 #back-to-top-ring 的 r 对上（viewBox 48×48）。
    // 改按钮尺寸不用动这里：SVG 是 100% 拉伸的，周长只跟 viewBox 内的几何有关。
    var RING_RADIUS = 21;
    var RING_LEN = 2 * Math.PI * RING_RADIUS;

    // 缓存可滚动高度：每帧读 scrollHeight 会触发重排，这里只在尺寸变化时重算
    var scrollMax = 0;
    function measureScrollMax() {
        var doc = document.documentElement;
        var body = document.body;
        scrollMax = Math.max(body.scrollHeight, doc.scrollHeight) - window.innerHeight;
    }

    function initProgressRing() {
        var ring = document.getElementById('back-to-top-ring');
        if (!ring) return;
        ring.style.strokeDasharray = RING_LEN.toFixed(2);
        ring.style.strokeDashoffset = RING_LEN.toFixed(2); // 初始 0%
    }

    function updateProgressRing() {
        var ring = document.getElementById('back-to-top-ring');
        if (ring) {
            var doc = document.documentElement;
            var body = document.body;
            var top = body.scrollTop || doc.scrollTop || 0;
            var p = scrollMax > 0 ? Math.min(1, Math.max(0, top / scrollMax)) : 0;
            ring.style.strokeDashoffset = (RING_LEN * (1 - p)).toFixed(2);
        }
        syncActiveItem(); // 同一个滚动源；弹窗没开时它自己会立刻返回
    }

    var toolbarRaf = 0;
    function onToolbarScroll() {
        if (toolbarRaf) return;
        toolbarRaf = requestAnimationFrame(function () {
            toolbarRaf = 0;
            updateProgressRing();
        });
    }

    // ===== 事件绑定（仅绑定一次，用标志位防止重复） =====
    var toolbarBound = false;
    function bindToolbarEvents() {
        if (toolbarBound) return;
        toolbarBound = true;

        // 点击弹窗与按钮之外的地方关闭
        document.addEventListener('click', function (e) {
            var popup = document.getElementById('toc-popup');
            if (!popup || !popup.classList.contains('is-open')) return;
            var t = e.target;
            if (!(t instanceof Node)) return;
            if (popup.contains(t)) return;
            var btn = document.getElementById('show-toc-btn');
            if (btn && btn.contains(t)) return;
            toolbarCloseToc();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') toolbarCloseToc();
        });

        var popup = document.getElementById('toc-popup');
        if (popup) {
            popup.addEventListener('click', function (e) {
                var a = e.target instanceof Element ? e.target.closest('a[href^="#"]') : null;
                if (!a) return;
                e.preventDefault();
                var raw = (a.getAttribute('href') || '').slice(1);
                var target = document.getElementById(decodeURIComponent(raw));
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                if (history.replaceState) history.replaceState(null, '', '#' + raw);
                setTimeout(toolbarCloseToc, 180);
            });
        }
    }

    // ===== 初始化 =====
    var scrollBound = false;
    function bindScroll() {
        if (scrollBound) return;
        scrollBound = true;
        window.addEventListener('scroll', onToolbarScroll, { passive: true });
        window.addEventListener('resize', function () {
            measureScrollMax();
            onToolbarScroll();
        }, { passive: true });
    }

    function initToolbar() {
        updateTocBtnVisibility();
        bindToolbarEvents();
        initProgressRing();
        bindScroll();
        measureScrollMax();
        updateProgressRing();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initToolbar);
    } else {
        initToolbar();
    }

    // ===== Swup 页面切换后：关闭弹窗 + 更新按钮可见性 + 重算进度 =====
    function setupSwupHooks() {
        if (!window.swup) return;
        window.swup.hooks.on('content:replace', function () {
            toolbarCloseToc(); // 关闭可能开着的弹窗
            updateTocBtnVisibility();
            setTimeout(updateTocBtnVisibility, 1500); // 评论懒加载，稍后再确认一次
            requestAnimationFrame(function () {
                measureScrollMax();
                updateProgressRing();
            });
        });
    }
    if (window.swup) {
        setupSwupHooks();
    } else {
        document.addEventListener('swup:enable', setupSwupHooks);
    }
})();


/* =====================================================================
 * 悬浮工具栏音乐播放器（复刻自 v-blog.halei0v0.top）
 *
 * 设计要点：
 *  1) 站点级单例 —— <audio> 挂在 window，不插入 DOM。Swup 只替换 main / #toc，
 *     工具栏整体在替换范围之外，所以切页不重建、不打断播放。
 *  2) 脚本可能被 Swup 更新 <head> 时重跑 —— 用 window 标志位兜住；即使重跑，
 *     事件绑定用 onclick 赋值（幂等）而不是 addEventListener，不会叠加。
 *  3) DOM 一律懒取（每次 $() 查一次），避免缓存了被替换的节点。
 *  4) 面板位置按工具栏实测位置算，才能跟着「石蒜挂件上抬工具栏」一起走。
 * ===================================================================== */
(function () {
    'use strict';

    if (window.__musicFabBooted) return;
    window.__musicFabBooted = true;

    var btn0 = document.getElementById('music-fab-btn');
    if (!btn0) return; // 未启用音乐播放器

    var CFG = null;
    try {
        CFG = JSON.parse(btn0.getAttribute('data-music-config') || 'null');
    } catch (e) {
        CFG = null;
    }
    if (!CFG || !CFG.enable) return;

    var VOLUME_KEY = 'fuwari-music-volume';
    var NOTICE_MS = 3200;

    /* ---------- 状态（挂 window，脚本重跑也不丢） ---------- */
    var S = window.__musicFabState;
    if (!S) {
        var vol0 = parseFloat(CFG.volume);
        if (!isFinite(vol0)) vol0 = 0.7;
        try {
            var saved = localStorage.getItem(VOLUME_KEY);
            if (saved !== null) {
                var v0 = parseFloat(saved);
                if (isFinite(v0) && v0 >= 0 && v0 <= 1) vol0 = v0;
            }
        } catch (e) { /* 隐私模式忽略 */ }
        S = {
            list: [],
            index: 0,
            current: null,
            playing: false,
            loading: false,
            open: false,
            view: 'player',
            shuffle: false,
            repeat: 0,
            volume: vol0,
            muted: vol0 === 0,
            time: 0,
            duration: 0,
            wantPlay: false,
            blocked: false,
            notice: '',
            noticeAt: 0,
            listLoaded: false
        };
        window.__musicFabState = S;
    }

    var audio = window.__musicFabAudio || (window.__musicFabAudio = new Audio());
    audio.preload = 'metadata';
    audio.volume = S.volume;
    audio.muted = S.muted;

    /* ---------- 小工具 ---------- */
    function $(id) { return document.getElementById(id); }
    function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function resolveUrl(u) {
        if (!u) return '';
        if (/^https?:\/\//i.test(u) || u.charAt(0) === '/') return u;
        return '/' + u;
    }

    function fmtTime(sec) {
        if (!isFinite(sec) || sec <= 0) return '0:00';
        sec = Math.floor(sec);
        var m = Math.floor(sec / 60);
        var s = sec % 60;
        return m + ':' + (s < 10 ? '0' : '') + s;
    }

    /* ---------- 面板定位：贴着音乐按钮弹出 ---------- */
    // 面板在「音乐按钮左侧」展开、底边与按钮底边齐平。
    // 为什么不用「底边对齐整条工具栏的顶端」：本站工具栏有 6 个按钮（约 324px），
    // 石蒜挂件还会把整条抬到 bottom:15rem（240px），两者相加约 564px —— 面板底边
    // 会跑到离屏幕底 576px 处，点开后离按钮非常远。贴按钮走既近，也不遮工具栏其余按钮。
    function positionPanel() {
        var panel = $('music-panel');
        var bar = document.querySelector('.floating-toolbar');
        if (!panel || !bar || !panel.classList.contains('is-open')) return;

        var btn = $('music-fab-btn');
        var anchor = btn && btn.getBoundingClientRect();
        // 按钮缺失或未布局（rect 全 0）时回退到整条工具栏
        if (!anchor || !anchor.width || !anchor.bottom) anchor = bar.getBoundingClientRect();

        var gap = 12;
        var w = panel.offsetWidth || 320;

        // 水平：面板右边缘落在按钮左侧 gap 处；左侧空间不够就贴视口左边 8px（窄屏降级）
        panel.style.left = Math.max(8, anchor.left - gap - w) + 'px';
        panel.style.right = 'auto';
        // 垂直：面板底边与按钮底边齐平
        panel.style.bottom = Math.max(8, window.innerHeight - anchor.bottom) + 'px';
        // 高度：上限是按钮底边以上的可用空间，超出时面板内部滚动
        panel.style.maxHeight = Math.max(220, anchor.bottom - gap * 2) + 'px';
    }

    /* ---------- 渲染 ---------- */
    function coverUrl() {
        if (!S.current) return '';
        return resolveUrl(S.current.cover);
    }

    function renderAll() {
        renderShell();
        renderMeta();
        renderTransport();
        renderProgress();
        renderList();
    }

    function renderShell() {
        var btn = $('music-fab-btn');
        var panel = $('music-panel');
        if (btn) {
            btn.classList.toggle('is-open', S.open);
            btn.setAttribute('aria-expanded', S.open ? 'true' : 'false');
            var label = S.current && S.current.title
                ? '打开音乐控制中心：' + S.current.title
                : '打开音乐控制中心';
            btn.setAttribute('aria-label', S.open ? '收起音乐控制中心' : label);
            btn.title = S.open ? '收起音乐控制中心' : label;
        }
        if (panel) {
            panel.classList.toggle('is-open', S.open);
            panel.setAttribute('aria-hidden', S.open ? 'false' : 'true');
            var views = panel.querySelectorAll('.music-view');
            for (var i = 0; i < views.length; i++) {
                views[i].hidden = views[i].getAttribute('data-view') !== S.view;
            }
        }
        if (S.open) positionPanel();
    }

    function renderMeta() {
        var panel = $('music-panel');
        var img = $('music-cover');
        var title = $('music-title');
        var artist = $('music-artist');
        var notice = $('music-notice');

        if (title) {
            var t = S.current ? S.current.title : '未在播放';
            title.textContent = t;
            title.title = t;
        }
        if (artist) {
            artist.textContent = S.current ? (S.current.artist || '未知艺术家') : '还没有曲目';
        }
        if (img) {
            var src = coverUrl();
            if (src) {
                if (img.getAttribute('src') !== src) {
                    img.classList.remove('is-loaded');
                    img.src = src;
                }
            } else {
                img.removeAttribute('src');
                img.classList.remove('is-loaded');
            }
        }
        if (notice) {
            var text = S.notice || (S.loading && !S.list.length ? '歌单加载中…' : '');
            notice.hidden = !text;
            notice.textContent = text;
        }
        if (panel) {
            panel.setAttribute('data-playing', S.playing ? '1' : '0');
            panel.setAttribute('data-repeat', String(S.repeat));
            panel.setAttribute('data-shuffle', S.shuffle ? '1' : '0');
            panel.setAttribute('data-vol', S.muted || S.volume === 0 ? 'off' : (S.volume < 0.5 ? 'low' : 'high'));
        }
    }

    function renderTransport() {
        var btn = $('music-fab-btn');
        if (btn) {
            btn.classList.toggle('is-loading', S.loading);
            btn.classList.toggle('is-playing', S.playing);
        }
        var panel = $('music-panel');
        if (panel) {
            panel.setAttribute('data-playing', S.playing ? '1' : '0');
        }
        var canSkip = S.list.length > 1;
        ['music-prev', 'music-next'].forEach(function (id) {
            var el = $(id);
            if (el) {
                el.disabled = !canSkip;
                el.style.opacity = canSkip ? '' : '0.35';
            }
        });
    }

    function renderProgress() {
        var total = S.duration || (S.current ? S.current.duration : 0) || 0;
        var ratio = total > 0 ? clamp(S.time / total, 0, 1) : 0;
        var fill = $('music-progress-fill');
        if (fill) fill.style.width = (ratio * 100).toFixed(2) + '%';
        var now = $('music-time-now');
        if (now) now.textContent = fmtTime(S.time);
        var tot = $('music-time-total');
        if (tot) tot.textContent = fmtTime(total);
        var bar = $('music-progress');
        if (bar) bar.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));

        var vfill = $('music-volume-fill');
        if (vfill) vfill.style.width = ((S.muted ? 0 : S.volume) * 100).toFixed(1) + '%';
        var vbar = $('music-volume');
        if (vbar) {
            vbar.setAttribute('aria-valuenow', String(Math.round((S.muted ? 0 : S.volume) * 100)));
        }
    }

    function eqHtml() {
        return '<span class="music-eq' + (S.playing ? '' : ' is-paused') + '"><i></i><i></i><i></i></span>';
    }

    function renderList() {
        var box = $('music-list');
        var count = $('music-list-count');
        if (count) count.textContent = S.list.length ? '(' + S.list.length + ')' : '';
        if (!box) return;

        if (!S.list.length) {
            box.innerHTML = '<div class="music-item music-item--empty">' + esc(S.notice || '暂无曲目') + '</div>';
            return;
        }

        var html = '';
        for (var i = 0; i < S.list.length; i++) {
            var t = S.list[i];
            var active = i === S.index;
            html += '<div class="music-item' + (active ? ' is-active' : '') + '" role="option" tabindex="0" data-index="' + i + '" aria-selected="' + (active ? 'true' : 'false') + '">'
                + '<span class="music-item__no">' + (active ? eqHtml() : (i + 1)) + '</span>'
                + '<img class="music-item__cover" alt="" loading="lazy" decoding="async"' + (t.cover ? ' src="' + esc(resolveUrl(t.cover)) + '"' : '') + '>'
                + '<span class="music-item__meta">'
                + '<span class="music-item__title">' + esc(t.title || '未知曲目') + '</span>'
                + '<span class="music-item__artist">' + esc(t.artist || '未知艺术家') + '</span>'
                + '</span>'
                + '</div>';
        }
        box.innerHTML = html;
    }

    var noticeSeq = 0;
    function showNotice(msg, persist) {
        S.notice = msg;
        renderAll();
        if (persist) return; // 「歌单加载失败」这类要一直留在界面上
        var seq = ++noticeSeq;
        setTimeout(function () {
            if (seq !== noticeSeq) return;
            S.notice = '';
            renderAll();
        }, NOTICE_MS);
    }

    /* ---------- 播放列表加载 ---------- */
    function apiUrl() {
        return String(CFG.metingApi || '')
            .replace(':server', CFG.server || 'netease')
            .replace(':type', CFG.type || 'playlist')
            .replace(':id', CFG.id || '')
            .replace(':auth', '')
            .replace(':r', String(Date.now()));
    }

    function fromMeting(raw) {
        var d = raw.duration;
        if (typeof d === 'string') d = parseInt(d, 10);
        d = Number(d);
        if (!isFinite(d) || d < 0) d = 0;
        if (d > 10000) d = Math.floor(d / 1000); // meting 偶有毫秒
        return {
            id: raw.id || raw.song_id || 0,
            title: raw.name || raw.title || '未知曲目',
            artist: raw.artist || raw.author || '未知艺术家',
            cover: raw.pic || raw.cover || raw.image || '',
            url: raw.url || '',
            duration: d
        };
    }

    function applyList(list) {
        S.list = (list || []).filter(function (t) { return t && t.url; });
        S.loading = false;
        S.listLoaded = true;
        if (!S.list.length) {
            S.notice = CFG.mode === 'local' ? '本地播放列表为空' : '歌单为空';
            renderAll();
            return;
        }
        S.notice = '';
        load(0, !!CFG.autoplay);
    }

    function loadPlaylist() {
        if (CFG.mode === 'local') {
            applyList((CFG.localPlaylist || []).map(function (t) {
                return {
                    id: t.id,
                    title: t.title,
                    artist: t.artist,
                    cover: t.cover,
                    url: t.url,
                    duration: t.duration || 0
                };
            }));
            return;
        }

        S.loading = true;
        renderTransport();
        renderMeta();

        fetch(apiUrl(), { credentials: 'omit' })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function (json) {
                if (!Array.isArray(json)) throw new Error('bad payload');
                applyList(json.map(fromMeting));
            })
            .catch(function () {
                S.loading = false;
                showNotice('歌单加载失败，稍后再试', true);
                renderAll();
            });
    }

    /* ---------- 播放控制 ---------- */
    function load(i, play) {
        if (!S.list.length) return;
        if (i < 0) i = S.list.length - 1;
        if (i >= S.list.length) i = 0;

        S.index = i;
        S.current = S.list[i];
        S.time = 0;
        S.duration = S.current.duration || 0;
        S.wantPlay = !!play;
        S.loading = !!S.current.url;
        S.notice = '';

        audio.src = resolveUrl(S.current.url);
        audio.load();
        renderAll();
        if (play) playAudio();
    }

    function playAudio() {
        if (!S.current || !S.current.url) return;
        var p = audio.play();
        if (p && p.catch) {
            p.catch(function () {
                // 自动播放被拦：记下来，等用户第一次点/按键时补播
                S.blocked = true;
                S.playing = false;
                renderTransport();
            });
        }
    }

    function toggle() {
        if (!S.list.length) {
            if (!S.listLoaded && !S.loading) loadPlaylist();
            return;
        }
        if (!S.current) { load(S.index, true); return; }
        if (S.playing) audio.pause();
        else playAudio();
    }

    function next() {
        if (S.list.length <= 1) return;
        var i;
        if (S.shuffle) {
            do { i = Math.floor(Math.random() * S.list.length); } while (S.list.length > 1 && i === S.index);
        } else {
            i = S.index + 1 >= S.list.length ? 0 : S.index + 1;
        }
        load(i, true);
    }

    function prev() {
        if (S.list.length <= 1) return;
        // 播了一会儿再按「上一首」，先回到本曲开头（和主流播放器一致）
        if (audio.currentTime > 3) { audio.currentTime = 0; return; }
        load(S.index - 1, true);
    }

    function setVolume(v) {
        v = clamp(v, 0, 1);
        S.volume = v;
        S.muted = v === 0;
        audio.volume = v;
        audio.muted = S.muted;
        try { localStorage.setItem(VOLUME_KEY, String(v)); } catch (e) { /* 忽略 */ }
        renderProgress();
        renderMeta();
    }

    function toggleMute() {
        S.muted = !S.muted;
        audio.muted = S.muted;
        if (!S.muted && S.volume === 0) { S.volume = 0.7; audio.volume = 0.7; }
        renderProgress();
        renderMeta();
    }

    function setOpen(open) {
        S.open = !!open;
        if (S.open) {
            S.view = 'player';
            if (!S.listLoaded && !S.loading) loadPlaylist();
        }
        renderShell(); // 打开时在 renderShell 里统一重算面板位置
    }

    /* ---------- 音频事件 ---------- */
    audio.addEventListener('play', function () {
        S.playing = true;
        S.blocked = false;
        S.loading = false;
        renderTransport();
        renderMeta();
        renderList();
    });
    audio.addEventListener('pause', function () {
        S.playing = false;
        renderTransport();
        renderMeta();
        renderList();
    });
    audio.addEventListener('timeupdate', function () {
        S.time = audio.currentTime || 0;
        renderProgress();
    });
    audio.addEventListener('loadedmetadata', function () {
        S.loading = false;
        if (isFinite(audio.duration) && audio.duration > 1) {
            S.duration = Math.round(audio.duration);
        }
        renderAll();
        // 首次尝试就带播放意图的（autoplay / 用户点的下一首），元数据就绪后补播
        if (S.wantPlay || S.playing) playAudio();
    });
    audio.addEventListener('waiting', function () {
        S.loading = true;
        renderTransport();
    });
    audio.addEventListener('playing', function () {
        S.loading = false;
        renderTransport();
    });
    audio.addEventListener('ended', function () {
        if (S.repeat === 1) {
            audio.currentTime = 0;
            playAudio();
            return;
        }
        if (S.repeat === 0 && S.index >= S.list.length - 1 && !S.shuffle) {
            // 不循环：停在最后一首
            S.playing = false;
            renderTransport();
            renderMeta();
            renderList();
            return;
        }
        next();
    });
    audio.addEventListener('error', function () {
        S.loading = false;
        S.playing = false;
        if (!S.current) return;
        var name = S.current.title || '这首';
        if (S.list.length > 1) {
            showNotice('「' + name + '」播放不了，自动跳下一首');
            setTimeout(function () { next(); }, 1200);
        } else {
            showNotice('「' + name + '」播放失败');
        }
        renderAll();
    });

    /* ---------- 交互：拖拽条 ---------- */
    function bindSlider(el, onRatio, onEnd) {
        if (!el) return;
        el.addEventListener('pointerdown', function (ev) {
            ev.preventDefault();
            if (el.setPointerCapture) {
                try { el.setPointerCapture(ev.pointerId); } catch (e) { /* 忽略 */ }
            }
            el.classList.add('is-dragging');

            function ratio(e) {
                var r = el.getBoundingClientRect();
                return clamp((e.clientX - r.left) / (r.width || 1), 0, 1);
            }
            onRatio(ratio(ev));

            function move(e) { onRatio(ratio(e)); }
            function up(e) {
                el.classList.remove('is-dragging');
                el.removeEventListener('pointermove', move);
                el.removeEventListener('pointerup', up);
                el.removeEventListener('pointercancel', up);
                if (onEnd) onEnd(ratio(e));
            }
            el.addEventListener('pointermove', move);
            el.addEventListener('pointerup', up);
            el.addEventListener('pointercancel', up);
        });
    }

    /* ---------- 绑定（幂等，脚本重跑也不会叠加） ---------- */
    function bindUI() {
        var btn = $('music-fab-btn');
        if (btn && btn.getAttribute('data-music-bound') !== '1') {
            btn.setAttribute('data-music-bound', '1');
            btn.addEventListener('click', function () { setOpen(!S.open); });
            btn.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    setOpen(!S.open);
                }
            });
        }

        var map = {
            'music-close': function () { setOpen(false); },
            'music-list-back': function () { S.view = 'player'; renderShell(); },
            'music-toggle': toggle,
            'music-next': function () { next(); },
            'music-prev': function () { prev(); },
            'music-shuffle': function () {
                S.shuffle = !S.shuffle;
                if (S.shuffle) S.repeat = 0;
                renderMeta();
            },
            'music-repeat': function () {
                S.repeat = (S.repeat + 1) % 3;
                if (S.repeat !== 0) S.shuffle = false;
                renderMeta();
            },
            'music-mute': toggleMute,
            'music-list-btn': function () {
                S.view = S.view === 'playlist' ? 'player' : 'playlist';
                renderShell();
                renderList();
            }
        };
        Object.keys(map).forEach(function (id) {
            var el = $(id);
            if (el && el.getAttribute('data-music-bound') !== '1') {
                el.setAttribute('data-music-bound', '1');
                el.onclick = map[id];
            }
        });

        var progress = $('music-progress');
        if (progress && progress.getAttribute('data-music-bound') !== '1') {
            progress.setAttribute('data-music-bound', '1');
            bindSlider(progress, function (r) {
                // 拖动时只更新视觉，松手才真正 seek
                var total = S.duration || 0;
                var fill = $('music-progress-fill');
                if (fill) fill.style.width = (r * 100).toFixed(2) + '%';
                var now = $('music-time-now');
                if (now && total > 0) now.textContent = fmtTime(r * total);
            }, function (r) {
                var total = S.duration || 0;
                if (total > 0) {
                    audio.currentTime = r * total;
                    S.time = r * total;
                }
                renderProgress();
            });
            progress.addEventListener('keydown', function (e) {
                var total = S.duration || 0;
                if (!total) return;
                if (e.key === 'ArrowRight') { audio.currentTime = Math.min(total, audio.currentTime + 5); e.preventDefault(); }
                if (e.key === 'ArrowLeft') { audio.currentTime = Math.max(0, audio.currentTime - 5); e.preventDefault(); }
            });
        }

        var volume = $('music-volume');
        if (volume && volume.getAttribute('data-music-bound') !== '1') {
            volume.setAttribute('data-music-bound', '1');
            bindSlider(volume, function (r) { setVolume(r); });
            volume.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowRight') { setVolume(S.volume + 0.05); e.preventDefault(); }
                if (e.key === 'ArrowLeft') { setVolume(S.volume - 0.05); e.preventDefault(); }
            });
        }

        var list = $('music-list');
        if (list && list.getAttribute('data-music-bound') !== '1') {
            list.setAttribute('data-music-bound', '1');
            list.addEventListener('click', function (e) {
                var item = e.target && e.target.closest ? e.target.closest('.music-item') : null;
                if (!item || !item.getAttribute('data-index')) return;
                var i = parseInt(item.getAttribute('data-index'), 10);
                if (!isFinite(i)) return;
                load(i, true);
            });
            list.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                var item = e.target && e.target.closest ? e.target.closest('.music-item') : null;
                if (!item) return;
                e.preventDefault();
                var i = parseInt(item.getAttribute('data-index'), 10);
                if (isFinite(i)) load(i, true);
            });
        }

        var cover = $('music-cover');
        if (cover && cover.getAttribute('data-music-bound') !== '1') {
            cover.setAttribute('data-music-bound', '1');
            cover.addEventListener('load', function () { cover.classList.add('is-loaded'); });
            cover.addEventListener('error', function () { cover.classList.remove('is-loaded'); });
        }
    }

    /* ---------- 首次交互补播（自动播放被拦时） ---------- */
    function armResume() {
        function resume() {
            document.removeEventListener('pointerdown', resume);
            document.removeEventListener('keydown', resume);
            if (S.blocked) {
                S.blocked = false;
                playAudio();
            }
        }
        document.addEventListener('pointerdown', resume);
        document.addEventListener('keydown', resume);
    }

    /* ---------- 面板外点击收起 ---------- */
    function bindOutsideClose() {
        document.addEventListener('pointerdown', function (e) {
            if (!S.open) return;
            var panel = $('music-panel');
            var btn = $('music-fab-btn');
            var t = e.target;
            if (panel && t && panel.contains(t)) return;
            if (btn && t && btn.contains(t)) return;
            setOpen(false);
        });
    }

    /* ---------- 启动 ---------- */
    function boot() {
        bindUI();
        renderAll();
        // 预热：首屏不抢带宽，空闲时再把歌单拉回来（用户点开面板时也会立即拉）
        var warm = function () {
            if (!S.listLoaded && !S.loading) loadPlaylist();
        };
        if (window.requestIdleCallback) {
            window.requestIdleCallback(warm, { timeout: 3000 });
        } else {
            setTimeout(warm, 1800);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }

    window.addEventListener('resize', function () {
        if (S.open) positionPanel();
    });

    bindOutsideClose();
    armResume();

    // Swup 切页后：DOM 若被重建过（正常不会），这里自愈重绑一次
    function rebind() {
        bindUI();
        renderAll();
    }
    if (window.swup && window.swup.hooks) {
        window.swup.hooks.on('page:view', rebind);
    } else {
        document.addEventListener('swup:enable', function () {
            if (window.swup && window.swup.hooks) window.swup.hooks.on('page:view', rebind);
        });
    }

    // 供调试/其它脚本读取
    window.musicPlayer = {
        state: S,
        audio: audio,
        open: function () { setOpen(true); },
        close: function () { setOpen(false); },
        play: playAudio,
        pause: function () { audio.pause(); },
        next: next,
        prev: prev,
        reload: function () { S.listLoaded = false; loadPlaylist(); }
    };
})();
</script>
