		Hohhot: "呼和浩特市",
		Baotou: "包头市",
		"Lhasa": "拉萨市",
		Xining: "西宁市",
		Yinchuan: "银川市",
		"Shijiazhuang": "石家庄市",
		Tangshan: "唐山市",
		Baoding: "保定市",
		Harbin: "哈尔滨市",
		Daqing: "大庆市",
		Changchun: "长春市",
		Jilin: "吉林市",
		Shenyang: "沈阳市",
		Dalian: "大连市",
		Anshan: "鞍山市",
	};

	function calculateDistanceKmRounded(lat: number, lon: number): number {
		const R = 6371;
		const rad = Math.PI / 180;
		const dLat = (lat - HOME_LAT) * rad;
		const dLon = (lon - HOME_LON) * rad;
		const a =
			Math.sin(dLat / 2) * Math.sin(dLat / 2) +
			Math.cos(HOME_LAT * rad) * Math.cos(lat * rad) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
		const km = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
		return Number.isFinite(km) ? Math.round(km) : NaN;
	}

	function isValidIp(ip: string): boolean {
		if (/^(?:(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d?\d)$/.test(ip)) return true;
		return ip.includes(":") && /^[0-9a-fA-F:]+$/.test(ip) && ip.length >= 2;
	}

	function formatLocation(country: string, province: string, city: string): string {
		if (country !== "CN") {
			return country || "神秘地区";
		}
		const p = PROVINCE_MAP[province] ?? "";
		const c = CITY_MAP[city] ?? "";
		const joined = `${p} ${c}`.trim();
		return joined || "中国";
	}

	function readCache(): Record<string, unknown> | null {
		try {
			const raw = localStorage.getItem(CACHE_KEY);
			if (!raw) return null;
			const parsed = JSON.parse(raw);
			if (!parsed || typeof parsed !== "object") return null;
			if (!parsed.timestamp || Date.now() - parsed.timestamp > CACHE_DURATION) {
				localStorage.removeItem(CACHE_KEY);
				return null;
			}
			if (typeof parsed.ipText === "string" && parsed.ipText !== "未知" && !isValidIp(parsed.ipText)) return null;
			return parsed;
		} catch {
			return null;
		}
	}

	function writeCache(obj: Record<string, unknown>): void {
		try {
			localStorage.setItem(CACHE_KEY, JSON.stringify(obj));
		} catch {
			/* ignore */
		}
	}

	async function fetchWithTimeout(url: string, ms = 5000): Promise<Response> {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), ms);
		try {
			return await fetch(url, { signal: controller.signal });
		} finally {
			clearTimeout(timer);
		}
	}

	function setText(id: string, text: string): void {
		const el = document.getElementById(id);
		if (el) el.textContent = text;
	}

	function applyToUI(payload: Record<string, unknown>): void {
		setText("geo-city", String(payload.locationText ?? "未知"));
		setText("geo-ip", String(payload.ipText ?? "未知"));
		setText("geo-distance", Number.isFinite(payload.distanceKm) ? String(payload.distanceKm) : "--");
	}

	async function loadGeoData(): Promise<void> {
		const apiBase = commentConfig.apiBase.replace(/\/+$/, "");
		const cityEl = document.getElementById("geo-city");
		const ipEl = document.getElementById("geo-ip");
		const distanceEl = document.getElementById("geo-distance");
		if (!cityEl || !ipEl || !distanceEl || !apiBase) return;

		setText("geo-city", "加载中");
		setText("geo-ip", "加载中");
		setText("geo-distance", "--");

		const cached = readCache();
		if (cached) {
			applyToUI(cached);
			return;
		}

		try {
			const res = await fetchWithTimeout(`${apiBase}/geo`, 5000);
			if (!res.ok) throw new Error("HTTP error");
			const data = (await res.json()) as Record<string, unknown>;

			const ip = String(data.ip ?? "").trim();
			const lat = typeof data.lat === "number" ? data.lat : NaN;
			const lon = typeof data.lon === "number" ? data.lon : NaN;

			const payload: Record<string, unknown> = {
				ipText: isValidIp(ip) ? ip : "未知",
				locationText: formatLocation(String(data.country ?? ""), String(data.province ?? ""), String(data.city ?? "")),
				distanceKm: Number.isFinite(lat) && Number.isFinite(lon) ? calculateDistanceKmRounded(lat, lon) : NaN,
				timestamp: Date.now(),
			};

			applyToUI(payload);
			writeCache(payload);
		} catch {
			setText("geo-city", "未知");
			setText("geo-ip", "未知");
			setText("geo-distance", "--");
		}
	}

	function initDistanceWidget(): void {
		const root = document.getElementById("distance");
		if (!root) return;

		// 文章页隐藏该卡片（与原站行为一致）
		const isArticle = /^\/(posts|post)\//.test(location.pathname);
		const card = root.closest("widget-layout") as HTMLElement | null;
		if (card) card.style.display = isArticle ? "none" : "";
		if (isArticle) return;

		loadGeoData();
	}

	initDistanceWidget();
	document.addEventListener("astro:page-load", initDistanceWidget);
	document.addEventListener("swup:page:view", initDistanceWidget);
</script>
