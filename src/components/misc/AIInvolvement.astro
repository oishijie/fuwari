---
/**
 * AI 参与程度标示卡
 *
 * 复刻自 blog.7003410.xyz 文末的同名组件：左侧「AI 参与程度」标题 + 右侧三档状态 chip
 * + 底部一条细进度条，用来向读者声明这篇内容中 AI 的介入程度。
 *
 * 三档语义（程度由低到高）：
 *   none   不使用 —— 纯人工撰写
 *   polish 润色   —— AI 只做语言润色 / 错别字修订
 *   full   完全   —— AI 深度参与（草稿、成段生成等）
 *
 * 用法：文章 frontmatter 写 `aiLevel: polish`（省略时取 siteConfig 里的默认档）。
 * 组件为纯静态渲染，无客户端脚本，Swup 切页不受影响。
 *
 * ⚠️ 图标直接内联原站使用的 mdi path，避免引入新的 iconify 图标集依赖，
 *    同时保证与本项目已装的 material-symbols / fa6 之外零新增。
 */
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { AIInvolvementLevel } from "../../types/config";

interface Props {
	level?: AIInvolvementLevel;
	class?: string;
}

const { level = "none", class: className = "" } = Astro.props;

/* 原站使用的四个 mdi 图标（内联 path，20/24 单位 viewBox） */
const ICONS = {
	robot:
		"M17.5 15.5c0 1.11-.89 2-2 2s-2-.89-2-2s.9-2 2-2s2 .9 2 2m-9-2c-1.1 0-2 .9-2 2s.9 2 2 2s2-.89 2-2s-.89-2-2-2M23 15v3c0 .55-.45 1-1 1h-1v1c0 1.11-.89 2-2 2H5a2 2 0 0 1-2-2v-1H2c-.55 0-1-.45-1-1v-3c0-.55.45-1 1-1h1c0-3.87 3.13-7 7-7h1V5.73c-.6-.34-1-.99-1-1.73c0-1.1.9-2 2-2s2 .9 2 2c0 .74-.4 1.39-1 1.73V7h1c3.87 0 7 3.13 7 7h1c.55 0 1 .45 1 1m-2 1h-2v-2c0-2.76-2.24-5-5-5h-4c-2.76 0-5 2.24-5 5v2H3v1h2v3h14v-3h2z",
	pencil:
		"m14.06 9l.94.94L5.92 19H5v-.92zm3.6-6c-.25 0-.51.1-.7.29l-1.83 1.83l3.75 3.75l1.83-1.83c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29m-3.6 3.19L3 17.25V21h3.75L17.81 9.94z",
	autoFix:
		"M7.5 5.6L5 7l1.4-2.5L5 2l2.5 1.4L10 2L8.6 4.5L10 7zm12 9.8L22 14l-1.4 2.5L22 19l-2.5-1.4L17 19l1.4-2.5L17 14zM22 2l-1.4 2.5L22 7l-2.5-1.4L17 7l1.4-2.5L17 2l2.5 1.4zm-8.66 10.78l2.44-2.44l-2.12-2.12l-2.44 2.44zm1.03-5.49l2.34 2.34c.39.37.39 1.02 0 1.41L5.04 22.71c-.39.39-1.04.39-1.41 0l-2.34-2.34c-.39-.37-.39-1.02 0-1.41L12.96 7.29c.39-.39 1.04-.39 1.41 0",
	accountEdit:
		"M2 17v3h8v-1.89H3.9V17c0-.64 3.13-2.1 6.1-2.1c.96.01 1.91.14 2.83.38l1.52-1.52c-1.4-.47-2.85-.73-4.35-.76c-2.67 0-8 1.33-8 4m8-13C7.79 4 6 5.79 6 8s1.79 4 4 4s4-1.79 4-4s-1.79-4-4-4m0 6c-1.1 0-2-.89-2-2s.9-2 2-2s2 .9 2 2s-.89 2-2 2m11.7 3.35l-1 1l-2.05-2l1-1a.55.55 0 0 1 .77 0l1.28 1.28c.21.21.21.56 0 .77M12 18.94l6.06-6.06l2.05 2l-6 6.07H12z",
};

interface LevelDef {
	key: AIInvolvementLevel;
	label: string;
	icon: string;
	/** 进度条宽度：不使用为 0，润色 1/3，完全满格 */
	barWidth: string;
	/** 进度条填充色 */
	barColor: string;
	/** 激活态 chip 配色（含 ring） */
	chipActive: string;
}

const LEVELS: LevelDef[] = [
	{
		key: "polish",
		label: i18n(I18nKey.aiLevelPolish),
		icon: ICONS.pencil,
		barWidth: "w-1/3",
		barColor: "bg-green-400",
		chipActive:
			"bg-green-50 dark:bg-green-900/20 text-green-600 dark:text-green-400 ring-1 ring-green-200 dark:ring-green-800",
	},
	{
		key: "full",
		label: i18n(I18nKey.aiLevelFull),
		icon: ICONS.autoFix,
		barWidth: "w-full",
		barColor: "bg-amber-400",
		chipActive:
			"bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 ring-1 ring-amber-200 dark:ring-amber-800",
	},
	{
		key: "none",
		label: i18n(I18nKey.aiLevelNone),
		icon: ICONS.accountEdit,
		barWidth: "w-0",
		barColor: "bg-black/20 dark:bg-white/20",
		chipActive:
			"bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60 ring-1 ring-black/10 dark:ring-white/15",
	},
];

const current = LEVELS.find((lv) => lv.key === level) ?? LEVELS[LEVELS.length - 1];
---

<div
	class:list={[
		"card-base px-6 py-4 rounded-xl border border-[var(--line-divider)]",
		className,
	]}
>
	<div class="flex items-center justify-between gap-4 flex-wrap">
		<!-- 左侧标题 -->
		<div class="flex items-center gap-2">
			<div class="h-8 w-8 rounded-lg bg-black/5 dark:bg-white/10 flex items-center justify-center">
				<svg
					viewBox="0 0 24 24"
					width="1em"
					height="1em"
					fill="currentColor"
					class="text-[var(--primary)] text-[1.25rem]"
					aria-hidden="true"
				><path d={ICONS.robot}></path></svg>
			</div>
			<span class="text-sm font-medium text-black/60 dark:text-white/60">{i18n(I18nKey.aiInvolvement)}</span>
		</div>

		<!-- 右侧三档状态 -->
		<div class="flex items-center gap-2">
			{
				LEVELS.map((lv) => (
					<div
						class:list={[
							"flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium transition",
							lv.key === current.key
								? lv.chipActive
								: "text-black/30 dark:text-white/30",
						]}
					>
						<svg
							viewBox="0 0 24 24"
							width="1em"
							height="1em"
							fill="currentColor"
							class="text-sm"
							aria-hidden="true"
						><path d={lv.icon}></path></svg>
						{lv.label}
					</div>
				))
			}
		</div>
	</div>

	<!-- 底部细进度条 -->
	<div class="mt-3 h-1 rounded-full bg-black/5 dark:bg-white/5 overflow-hidden">
		<div
			class:list={[
				"h-full rounded-full transition-all duration-500",
				current.barWidth,
				current.barColor,
			]}
		>
		</div>
	</div>
</div>
