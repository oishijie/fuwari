---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import Webviso from "@components/Webviso.astro";
import WelcomeToast from "@components/widget/WelcomeToast.astro";
import { petConfig, profileConfig, sakanaConfig, siteConfig, umamiConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;
// banner 图先到取图服务拿 302、再落到 Bing 的图 CDN，两者都值得预连接
const bannerOrigin = (() => {
	try {
		return new URL(siteConfig.banner.src).origin;
	} catch {
		return ""; // 本地相对路径（走 Astro <Image>）没有外部源可预连接
	}
})();

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || siteConfig.description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || siteConfig.description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || siteConfig.description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		{/* Umami 隐私友好分析（无 Cookie），仅在配置完整时加载 */}
		{umamiConfig.enable && umamiConfig.src && umamiConfig.websiteId && (
			<script is:inline async defer src={umamiConfig.src} data-website-id={umamiConfig.websiteId} data-domains={Astro.site?.hostname}></script>
		)}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<!-- banner 图：先到取图服务拿 302，再落到 Bing CDN，预连接省掉两次握手 -->
		{enableBanner && bannerOrigin && (
			<>
				<link rel="preconnect" href={bannerOrigin} />
				<link rel="preconnect" href="https://cn.bing.com" />
			</>
		)}

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<ConfigCarrier></ConfigCarrier>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>

		<!-- 桌面宠物宿主：必须落在 Swup 容器（main / #toc）之外，
		     否则每次切页都会被整块替换，动画与拖拽位置全部丢失 -->
		{petConfig.enable && <div id="site-pet-host" aria-hidden="true"></div>}

		<!-- 右下角石蒜挂件宿主：同样必须落在 Swup 容器（main / #toc）之外，
		     否则每次切页都会被整块替换，实例与拖拽状态全部丢失。
		     宽高由客户端脚本按 sakanaConfig 注入（SDK 的 autoFit 需要确定尺寸的 BFC） -->
		{sakanaConfig.enable && <div id="sakana-host" class="sakana-host"></div>}

		<!-- 右下角→左下角欢迎浮层宿主：同样必须在 Swup 容器之外，切页才不会被整块替换。
		     固定定位 + 站点级单例，展示时机由 welcomeConfig.mode 控制 -->
		<WelcomeToast />

		<!-- Webviso 自托管访问统计（兼容 Swup） -->
		<Webviso />
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script>
import 'overlayscrollbars/overlayscrollbars.css';
import {
	OverlayScrollbars,
	// ScrollbarsHidingPlugin,
	// SizeObserverPlugin,
	// ClickScrollPlugin
} from 'overlayscrollbars';
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import {pathsEqual, url} from "../utils/url-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';

/* Preload fonts */
// (async function() {
// 	try {
// 		await Promise.all([
// 			document.fonts.load("400 1em Roboto"),
// 			document.fonts.load("700 1em Roboto"),
// 		]);
// 		document.body.classList.remove("hidden");
// 	} catch (error) {
// 		console.log("Failed to load fonts:", error);
// 	}
// })();

/* TODO This is a temporary solution for style flicker issue when the transition is activated */
/* issue link: https://github.com/withastro/astro/issues/8711, the solution get from here too */
/* update: fixed in Astro 3.2.4 */
/*
function disableAnimation() {
	const css = document.createElement('style')
	css.appendChild(
		document.createTextNode(
			`*{
              -webkit-transition:none!important;
              -moz-transition:none!important;
              -o-transition:none!important;
              -ms-transition:none!important;
              transition:none!important
              }`
		)
	)
	document.head.appendChild(css)

	return () => {
		// Force restyle
		;(() => window.getComputedStyle(document.body))()

		// Wait for next tick before removing
		setTimeout(() => {
			document.head.removeChild(css)
		}, 1)
	}
}
*/

const bannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])

/* ===== 长代码块：溢出检测 + 底部渐隐提示 ===== */
function initCodeClips() {
	document.querySelectorAll('.expressive-code pre').forEach((pre) => {
		const frame = pre.closest('.frame');
		if (!frame) return;
		const clipped = pre.scrollHeight > pre.clientHeight + 4;
		frame.classList.toggle('is-clipped', clipped);
		frame.classList.toggle('is-scrolled-end', !clipped);
	});
}

/* scroll 不冒泡，用捕获阶段委托；滚到底部时移除渐隐 */
document.addEventListener('scroll', (e) => {
	const t = e.target as Node;
	if (!(t instanceof HTMLElement) || t.tagName !== 'PRE') return;
	const frame = t.closest('.frame');
	if (!frame) return;
	const pre = t as HTMLPreElement;
	if (pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 12) {
		frame.classList.remove('is-clipped');
		frame.classList.add('is-scrolled-end');
	} else if (pre.scrollHeight > pre.clientHeight + 4) {
		frame.classList.add('is-clipped');
		frame.classList.remove('is-scrolled-end');
	}
}, true);

document.addEventListener('astro:page-load', initCodeClips);
document.addEventListener('swup:page:view', initCodeClips);
initCodeClips();


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function initCustomScrollbar() {
	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	OverlayScrollbars(
		// docs say that a initialization to the body element would affect native functionality like window.scrollTo
		// but just leave it here for now
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 500,
			autoHideSuspend: false,
		},
	});

	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		container.setAttribute('aria-label', 'scrollable container for formulas');

		element.parentNode.insertBefore(container, element);
		container.appendChild(element);

		OverlayScrollbars(container, {
			scrollbars: {
				theme: 'scrollbar-base scrollbar-auto',
				autoHide: 'leave',
				autoHideDelay: 500,
				autoHideSuspend: false
			}
		});

		element.setAttribute('data-scrollbar-initialized', 'true');
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
			processKatexElement(entry.target as HTMLElement);
			observer.unobserve(entry.target);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	initCustomScrollbar();
	showBanner();
}

/* Load settings when entering the site */
init();

const setup = () => {
	// 关掉 Swup 的「跨页滚动动画」（@swup/scroll-plugin 默认 animateScroll.betweenPages = true）。
	// 默认行为：切页时不立即归零，而是等新内容替换完，再用 scrl 做逐帧惯性滚动，
	// 从「当前阅读位置」缓缓滑回页面顶部 —— 和 DOM 替换、banner 高度变化、侧栏折叠
	// 挤在同一帧里，读文章读到一半点链接就会明显卡一下。
	// 这里把跨页这一档改成瞬时归零（scrollTo(0,0)），同页 hash 锚点与前进/后退的
	// 滚动位置恢复仍由插件负责，不受影响。
	type ScrollPluginLike = {
		name?: string
		options?: { animateScroll?: boolean | { betweenPages?: boolean } }
	}
	const swupInstance = window.swup as unknown as { plugins?: ScrollPluginLike[] } | undefined
	const scrollPlugin = swupInstance?.plugins?.find((p) => p?.name === 'SwupScrollPlugin')
	const animateScroll = scrollPlugin?.options?.animateScroll
	if (typeof animateScroll === 'boolean') {
		// TS 无法从 animateScroll 反推出父级非空，这里显式再判一次
		if (scrollPlugin?.options) {
			scrollPlugin.options.animateScroll = false
		}
	} else if (animateScroll && typeof animateScroll === 'object') {
		animateScroll.betweenPages = false
	}

	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!bannerEnabled) {
			return
		}
		let threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		let navbar = document.getElementById('navbar-wrapper')
		if (!navbar || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('content:replace', initCustomScrollbar)
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const toc = document.getElementById('toc-wrapper');
            if (toc) {
                toc.classList.remove('toc-not-ready')
            }
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let navbar = document.getElementById('navbar-wrapper')
function scrollFunction() {
	let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)

	if (backToTopBtn) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}

	if (bannerEnabled && toc) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			toc.classList.remove('toc-hide')
		} else {
			toc.classList.add('toc-hide')
		}
	}

	if (!bannerEnabled) return
	if (navbar) {
		const NAVBAR_HEIGHT = 72
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16			// The height the main panel overlaps the banner

		let bannerHeight = BANNER_HEIGHT
		if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
			bannerHeight = BANNER_HEIGHT_HOME
		}
		let threshold = window.innerHeight * (bannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		} else {
			navbar.classList.remove('navbar-hidden')
		}
	}
}
window.onscroll = scrollFunction

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}

/* 加密文章解密后：注入的图片不在初始 DOM 中，重建灯箱以重新绑定点击 */
document.addEventListener("password:decrypted", () => {
	try {
		lightbox?.destroy?.()
	} catch {
		/* ignore */
	}
	createPhotoSwipe()
})
</script>

<script>
	// ===== 站点桌面宠物（CodexPet Embed SDK，public/lib/codex-pet.js）=====
	// 挂载策略三要点：
	//   1) 站点级浮层 —— 宿主挂在 Swup 容器（main / #toc）之外，切页不重载、不叠加
	//   2) 单例守卫 —— Swup 更新 <head> 时可能重跑本脚本，用 window 标志位兜住
	//   3) 延迟下发 —— 雪碧图 2MB 级，等 load + 空闲再拉，不拖首屏
	import { petConfig as cfg } from "@/config";

	const BASE = import.meta.env.BASE_URL || "/";
	const narrow = window.matchMedia("(max-width: 767px)");

	function syncVisibility() {
		const p = (window as any).sitePet;
		if (!p) return;
		if (cfg.hideOnMobile && narrow.matches) p.hide();
		else p.show();
	}

	function mountPet() {
		if (!cfg.enable) return;
		if ((window as any).__sitePetBooted) return;
		(window as any).__sitePetBooted = true;

		const base = `${BASE}pets/${cfg.id}/`;
		const options = {
			petJson: `${base}pet.json`,
			spritesheet:
				cfg.spritesheet && cfg.spritesheet.trim()
					? cfg.spritesheet.trim()
					: `${base}spritesheet.webp`,
			mode: "fixed",
			position: cfg.position,
			scale: cfg.scale,
			speed: cfg.speed,
			state: cfg.state,
			margin: cfg.margin,
			zIndex: cfg.zIndex,
			draggable: cfg.draggable,
			clickCycle: cfg.clickCycle,
			onReady(inst: any) {
				(window as any).sitePet = inst;
				syncVisibility();
			},
			onError(err: any, inst: any) {
				// 控制台看得到就够了，不该让访客看到 SDK 注入的调试红框
				console.warn("[sitePet]", err && err.message);
				try {
					inst?.shadow?.querySelector(".cp-error")?.remove();
				} catch {
					/* ignore */
				}
			},
		};

		const mount = () => {
			const w = window as any;
			if (w.sitePet || !w.CodexPet) return;
			const host = document.getElementById("site-pet-host") || document.body;
			w.sitePet = w.CodexPet.mount(host, options);
			syncVisibility();
		};

		if ((window as any).CodexPet) {
			mount();
		} else {
			const s = document.createElement("script");
			s.src = `${BASE}lib/codex-pet.js`;
			s.async = true;
			s.onload = mount;
			document.head.appendChild(s);
		}
	}

	function schedulePet() {
		if (!cfg.enable) return;
		// 尊重系统的「减少动态效果」偏好
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		// 窄屏不加载：省流量，也不挡正文
		if (cfg.hideOnMobile && narrow.matches) return;
		const ric = (window as any).requestIdleCallback;
		if (typeof ric === "function") ric(mountPet, { timeout: 2500 });
		else setTimeout(mountPet, 1200);
	}

	if (document.readyState === "complete") schedulePet();
	else window.addEventListener("load", schedulePet, { once: true });

	/* 视口在窄/宽之间切换：已加载的只切显隐，没加载的补加载 */
	narrow.addEventListener("change", () => {
		if (!cfg.enable) return;
		if (narrow.matches) (window as any).sitePet?.hide();
		else if ((window as any).sitePet) (window as any).sitePet.show();
		else schedulePet();
	});

	/* 标签页不可见时暂停：否则 requestAnimationFrame 会在后台空转烧 CPU */
	document.addEventListener("visibilitychange", () => {
		const p = (window as any).sitePet;
		if (!p) return;
		if (document.hidden) p.pause();
		else p.resume();
	});
</script>

<script>
	// ===== 右下角「石蒜模拟器」挂件（Sakana! Widget，public/lib/sakana-widget.umd.min.js）=====
	// 与桌面宠物同一套挂载策略：
	//   1) 站点级浮层 —— 宿主挂在 Swup 容器（main / #toc）之外，切页不重载
	//   2) 单例守卫 —— Swup 更新 <head> 时可能重跑本脚本，用 window 标志位兜住
	//   3) 延迟下发 —— 87KB 自包含 UMD（角色图 base64 内联，零外部请求），等 load + 空闲再拉
	// 参数全部走 SDK 默认（size 200 / 默认物理），只为站内习惯调了层级、位置与关闭语义。
	// 两个 SDK 特性决定了写法：
	//   a) mount() 内部会 cloneNode(false) 替换宿主元素 —— 只能按 id 重新取，不能缓存引用；
	//      好在新宿主会继承 inline style，所以宽度/层级设置不会丢。
	//   b) 静止时 SDK 自己停帧（_run 里 motion < threshold 即 return），无需额外省电处理。
	//   c) SDK 顶层往 <head> 注入 <style>，会被 swup 的 head-plugin 在切页时清掉，
	//      必须打 data-swup-theme 标记 + 切页兜底重挂（见 captureSdkStyle）。
	import { sakanaConfig as sk } from "@/config";

	const BASE = import.meta.env.BASE_URL || "/";
	const narrowMq = window.matchMedia("(max-width: 767px)");
	/* 容器尺寸 = sk.size，且不做任何按视口的降级。
	   摇摆幅度上限是 maxR = clamp(size/5, 30, 60)：160→32°、200→40°。
	   所以「挂件小 = 摇得拘谨」，想改手感就调 size，别动这里。 */
	function getHost(): HTMLElement | null {
		// mount() 会把宿主替换成克隆体，所以每次都要重新取
		return document.getElementById("sakana-host");
	}

	/* 🔴 关键守卫：SDK 在「模块顶层」往 <head> 注入一个 <style>（全部 .sakana-widget-* 规则），
	   注入一次、永不重注。而本站 swup 开了 updateHead: true -> @swup/head-plugin 在切页时
	   会 removeChild 掉当前 head 中「新页面 head 里没有」的所有元素，只放过 title 与
	   [data-swup-theme]。那个 <style> 一旦被删，挂件永久失去样式：
	     .sakana-widget-img 的 background:50%/cover 退回默认 0% 0%/auto，
	     角色图按原始像素从左上角裁进 128px 的盒子 —— 那块几乎是透明的，
	     于是「人物消失、只剩 canvas 画的杆子」。
	   两道保险：① 打上 data-swup-theme 让 head-plugin 直接放过；
	             ② 留引用，切页后若真被删了就重新挂回去。 */
	// 引用挂 window 而不是模块变量：Swup 更新 head 后模块脚本可能被重跑，
	// 模块级 let 会被重新初始化成 null，window 属性则能跨次保留。
	function captureSdkStyle() {
		const w = window as any;
		if (w.__sakanaStyleEl && document.head.contains(w.__sakanaStyleEl)) return;
		const found = Array.from(document.head.querySelectorAll("style")).find((el) =>
			(el.textContent || "").includes("sakana-widget-wrapper"),
		);
		if (found) {
			found.setAttribute("data-swup-theme", "sakana-widget");
			w.__sakanaStyleEl = found;
		}
	}

	function restoreSdkStyle() {
		const w = window as any;
		if (!w.__sakanaStyleEl) {
			captureSdkStyle();
			return;
		}
		if (!document.head.contains(w.__sakanaStyleEl)) document.head.appendChild(w.__sakanaStyleEl);
	}

	function applyHostBox() {
		const host = getHost();
		if (!host) return;
		const px = sk.size;
		host.style.width = `${px}px`;
		host.style.height = `${px}px`;
		host.style.zIndex = String(sk.zIndex);
		// autoFit 用 ResizeObserver 观察内部 100% 宽的 wrapper，
		// 改完宿主尺寸 SDK 会自动重算 size，不必重新 mount
	}

	// 记住上次的显隐状态：SDK 的 show() 在组件本就没隐藏时会打 console.warn，
	// 而 mount 后与每次切页都会走这里，所以必须先比对再调。
	let sakanaHidden = false;
	function syncSakanaVisibility() {
		const w = (window as any).sakanaWidget;
		if (!w) return;
		const want = !!(sk.hideOnMobile && narrowMq.matches);
		if (want === sakanaHidden) return;
		sakanaHidden = want;
		if (want) w.hide();
		else w.show();
	}

	/* 只有挂件真的会出现时才上抬悬浮工具栏（CSS 认 html[data-sakana="on"]） */
	function syncToolbarLift() {
		const shown = !!(window as any).sakanaWidget && !(sk.hideOnMobile && narrowMq.matches);
		if (sk.enable && sk.liftToolbar && shown) {
			document.documentElement.setAttribute("data-sakana", "on");
		} else {
			document.documentElement.removeAttribute("data-sakana");
		}
	}

	function mountSakana() {
		if (!sk.enable) return;
		if ((window as any).__sakanaBooted) return;
		(window as any).__sakanaBooted = true;

		const host = getHost();
		const Sakana = (window as any).SakanaWidget;
		if (!host || !Sakana) {
			(window as any).__sakanaBooted = false;
			return;
		}

		applyHostBox();

		try {
			// 全部走 SDK 默认参数（与参考站一致）：默认 size 200、autoFit、默认物理
			const widget = new Sakana({
				size: sk.size,
				autoFit: true, // 按容器缩放，最小 120
				character: sk.character,
				controls: sk.controls,
				rod: sk.rod,
				draggable: sk.draggable,
				saveState: sk.saveState,
				stateKey: "sakana-widget-status",
			}).mount(host);

			(window as any).sakanaWidget = widget;
			syncSakanaVisibility();
			syncToolbarLift();
			patchCloseButton(widget);
			captureSdkStyle(); // 给 SDK 注入的 <style> 打免删标记，见上方注释
		} catch (err) {
			(window as any).__sakanaBooted = false;
			console.warn("[sakana]", err && (err as Error).message);
		}
	}

	/* 上游默认：点底座关闭按钮 = unmount()（彻底移除）。
	   这里只做收尾——卸载后把工具栏放回原位，免得下方空出一块；
	   saveState 仍由配置决定，不干预 SDK 行为。 */
	function patchCloseButton(widget: any) {
		const ctrl = getHost()?.querySelector(".sakana-widget-ctrl");
		const closeBtn = ctrl && ctrl.lastElementChild;
		if (!closeBtn) return;
		closeBtn.addEventListener("click", () => {
			requestAnimationFrame(() => {
				if (!getHost()?.querySelector(".sakana-widget-wrapper")) {
					(window as any).sakanaWidget = null;
					syncToolbarLift();
				}
			});
		});
	}

	function scheduleSakana() {
		if (!sk.enable) return;
		// 尊重系统的「减少动态效果」偏好
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		// 窄屏不加载：省流量，也不挡正文
		if (sk.hideOnMobile && narrowMq.matches) return;
		const ric = (window as any).requestIdleCallback;
		if (typeof ric === "function") ric(bootSakana, { timeout: 2500 });
		else setTimeout(bootSakana, 1200);
	}

	function bootSakana() {
		if (!sk.enable) return;
		const w = window as any;
		if (w.SakanaWidget) {
			mountSakana();
			return;
		}
		if (w.__sakanaLoading) return;
		w.__sakanaLoading = true;
		const s = document.createElement("script");
		s.src = `${BASE}lib/sakana-widget.umd.min.js`;
		s.async = true;
		s.onload = () => {
			w.__sakanaLoading = false;
			mountSakana();
		};
		s.onerror = () => {
			w.__sakanaLoading = false;
			console.warn("[sakana] SDK 加载失败");
		};
		document.head.appendChild(s);
	}

	if (document.readyState === "complete") scheduleSakana();
	else window.addEventListener("load", scheduleSakana, { once: true });

	/* 视口跨断点：已加载的只切显隐，没加载的补加载；矮屏切换时改宿主尺寸 */
	narrowMq.addEventListener("change", () => {
		if (!sk.enable) return;
		if ((window as any).sakanaWidget) syncSakanaVisibility();
		else if (!narrowMq.matches) scheduleSakana();
		syncToolbarLift();
	});

	/* Swup 切页后：<html> 属性可能被上游脚本改写，且 head-plugin 可能清掉 SDK 的 <style>，
	   所以这里既重新断言工具栏状态，也兜底把样式挂回去。 */
	document.addEventListener("swup:page:view", () => {
		if (!sk.enable) return;
		applyHostBox();
		syncToolbarLift();
		restoreSdkStyle();
	});
</script>
