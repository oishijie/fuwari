---
import BackToTop from "@components/control/BackToTop.astro";
import ImmersiveReading from "@components/control/ImmersiveReading.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	/** 该页侧栏是否支持折叠（默认折叠、正文吃满 --page-width、可手动展开）。文章页开启。 */
	sidebarCollapsible?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	sidebarCollapsible = false,
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
// banner 图是自建 Worker 的动态跳转（…/today），署名去同一个服务的 /meta 取
const bannerMetaUrl = siteConfig.banner.src.replace(/\/today\/?$/, "/meta");

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>

<!-- 阅读模式（reading mode）状态机 —— 折叠与沉浸合并成一条三档光谱。
     档位由 <html data-sidebar="off|expanded|collapsed|immersive"> **单值**驱动：
       expanded  → 双栏，侧栏展开（最浅）
       collapsed → 收侧栏，导航 / banner 保留，正文收进 --read-width（**文章页默认档**）
       immersive → 隐去导航 / banner / 侧栏 / 页脚，正文更窄 + 常驻目录栏（最深）
       off       → 本页不适用（首页 / 归档 / 关于 …），保持原双栏
     工具栏那一枚按钮按 order() 循环切换；沉浸档的全部样式与目录栏见 ImmersiveReading.astro。

     🔴 单状态源（2026-09-20 合并）：沉浸原先用 body.immersive-reading 另起一套，与折叠并列，
        两套 CSS 都要靠 !important 抢特异性，还留下「两个开关同时开着算哪一档」的未定义状态。
        收进本属性后，档位天然互斥，既不需要比较特异性，也没有组合歧义。

     ⚠️ 本脚本在 swup 容器之外，切页**不会重跑**，所以「当前页支持不支持」不能用 Astro
        编译期注入的常量（会被固化成首屏那一份的值），只能运行时读 DOM 标记 —— 见 supportsCollapse()。 -->
<script is:inline>
(function () {
    var KEY = 'reading-mode';                              // sessionStorage：记住用户选的档位
    var ORDER = ['expanded', 'collapsed', 'immersive'];    // 循环顺序：由浅到深，到底回最浅
    var DEFAULT_MODE = 'collapsed';                        // 文章页默认档
    var VALID = { expanded: 1, collapsed: 1, immersive: 1 };
    var root = document.documentElement;
    var bound = false;
    var savedScroll = 0;        // 进沉浸前的滚动位置，退出时原样恢复
    var pendingUrl = null;      // swup 目标 URL（地址栏更新前唯一可靠的来源）

    // 判断是不是文章页：一律用「目标 URL」而不是 window.location。
    // swup 的 content:replace / page:view 触发时地址栏可能还没更新，读 location 会拿到上一页的路径。
    // 注意这只是首屏的兜底手段，主依据是下面的 DOM 标记。
    function isPostUrl(u) {
        var p;
        try { p = new URL(u || location.href, location.origin).pathname; }
        catch (e) { p = location.pathname; }
        return p.indexOf('/posts/') === 0;
    }

    function readPref() {
        try { var v = sessionStorage.getItem(KEY); return VALID[v] ? v : null; }
        catch (e) { return null; }
    }
    function writePref(v) {
        try { sessionStorage.setItem(KEY, v); } catch (e) { /* 隐私模式下忽略 */ }
    }

    // 🔴 「本页可不可切换档位」的**唯一真值来源**是 DOM 标记，它由本布局渲染在
    //    #content-wrapper（位于 <main id="swup-container"> 内部）上：
    //    swup 的容器是 ["main", "#toc"]，切页只换 main 的**内容** ——
    //    标记跟着新页面出现/消失，而 sidebar 与 #main-grid 本身从不被重建。
    function marked() {
        return !!document.querySelector('[data-sidebar-collapsible]');
    }
    function supportsCollapse(u) {
        if (marked()) return true;
        // main 已经在 DOM 里但没带标记 → 本页不支持（首页 / 归档 / 关于 …）
        if (document.getElementById('swup-container')) return false;
        // 首屏：本脚本同步执行于网格之前，<main> 还没解析出来，只能按路径兜底
        return isPostUrl(u);
    }

    // 沉浸档的配置来自 ImmersiveReading 渲染的 #immersive-root；组件被禁用时它不存在 → 该档不可达
    function immersiveCfg() {
        var el = document.getElementById('immersive-root');
        if (!el) return null;
        return {
            tocEnabled: el.dataset.tocEnabled === '1',
            tocPosition: el.dataset.tocPosition === 'right' ? 'right' : 'left',
            defaultOn: el.dataset.defaultOn === '1',
            tTocExpand: el.dataset.tTocExpand || '',
            tTocCollapse: el.dataset.tTocCollapse || ''
        };
    }
    // 与折叠一致：<1024px 本就是单列堆叠，沉浸档不参与
    function immersiveAvailable() {
        return !!immersiveCfg() && window.innerWidth >= 1024;
    }
    function order() {
        return immersiveAvailable() ? ORDER : ['expanded', 'collapsed'];
    }

    function stateFor(u) {
        if (!supportsCollapse(u)) return 'off';
        var pref = readPref();
        // 沉浸是「临时态」：不跨页面保留，回到文章页时给默认档
        if (pref && pref !== 'immersive') return pref;
        // 未设偏好时，看配置是否要求文章页默认就进沉浸（immersiveReadingConfig.defaultOn）
        var cfg = immersiveCfg();
        if (cfg && cfg.defaultOn && immersiveAvailable()) return 'immersive';
        return DEFAULT_MODE;
    }

    function current() {
        return root.getAttribute('data-sidebar') || 'off';
    }

    /* ---- 入口按钮：工具栏那一枚（容器外、切页不重建 → 只绑一次）。
            文案按「下一档会去哪」提示，三个 label 由 BackToTop 渲染时注入。 ---- */
    function syncButton() {
        var btn = document.getElementById('immersive-btn');
        if (!btn) return;
        var cur = current();
        btn.style.display = VALID[cur] ? '' : 'none';
        btn.classList.toggle('is-open', cur === 'immersive');
        var label = btn.getAttribute('data-label-collapsed') || '';
        if (cur === 'expanded') label = btn.getAttribute('data-label-expanded') || label;
        else if (cur === 'immersive') label = btn.getAttribute('data-label-immersive') || label;
        btn.setAttribute('title', label);
        btn.setAttribute('aria-label', label);
        btn.setAttribute('aria-pressed', cur === 'immersive' ? 'true' : 'false');
    }

    function syncTocBtn() {
        var cfg = immersiveCfg();
        var tb = document.getElementById('immersive-toc-btn');
        if (!cfg || !tb) return;
        var open = root.classList.contains('immersive-toc-open');
        var label = open ? cfg.tTocCollapse : cfg.tTocExpand;
        tb.setAttribute('title', label);
        tb.setAttribute('aria-label', label);
    }

    // 只在值真的变化时才写属性（重复写入会触发无谓的样式重算与过渡）。
    // animate=false 时先挂 data-sidebar-noanim 关掉过渡：swup 切页是「整页换布局」，
    // 栅格列宽与内边距都是容器宽度的函数，若在切换过程中逐帧插值，正文会来回重排 —— 既闪又卡。
    function setMode(next, animate) {
        var prev = current();
        if (prev === next) { syncButton(); syncTocBtn(); return; }

        if (VALID[next] && next !== 'immersive') writePref(next);

        if (!animate) root.setAttribute('data-sidebar-noanim', '');
        root.setAttribute('data-sidebar', next);

        // 目录栏子状态：只在沉浸档有意义。进沉浸默认展开（进来就能看到结构）；离开时清掉。
        if (next === 'immersive') {
            var cfg = immersiveCfg();
            root.classList.toggle('immersive-toc-open', !!(cfg && cfg.tocEnabled));
            root.classList.toggle('immersive-toc-right', !!(cfg && cfg.tocPosition === 'right'));
        } else {
            root.classList.remove('immersive-toc-open', 'immersive-toc-right');
        }

        syncButton();
        syncTocBtn();

        if (!animate) {
            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    root.removeAttribute('data-sidebar-noanim');
                });
            });
        }

        document.dispatchEvent(new CustomEvent('readingModeChange', { detail: { mode: next, prev: prev } }));
        // 兼容 ImmersiveReading 早期对外派发的事件名
        document.dispatchEvent(new CustomEvent('immersiveReadingChange', { detail: { on: next === 'immersive' } }));
    }

    /* 循环切换：展开 → 折叠 → 沉浸 → 展开。
       滚动处理放在这里（而不是 setMode）：只有手动换档才需要动滚动，
       swup 切页时动它会把人甩回顶部。 */
    function next() {
        var list = order();
        var prev = current();
        var i = list.indexOf(prev);
        if (i < 0) return;                       // off 态（非文章页）不响应
        var to = list[(i + 1) % list.length];

        if (to === 'immersive') savedScroll = window.scrollY || window.pageYOffset || 0;
        setMode(to, true);
        // 进沉浸归零；出沉浸回到进入前的位置（不是顶部）——直接跳，别让 scroll-plugin 做惯性动画
        if (to === 'immersive') window.scrollTo(0, 0);
        else if (prev === 'immersive') window.scrollTo(0, savedScroll || 0);
    }

    function toggleToc() {
        if (current() !== 'immersive') return;
        root.classList.toggle('immersive-toc-open');
        syncTocBtn();
    }

    // 切页 / 视口变化后重新对齐。切页时若本来就在沉浸档，保持沉浸（目录会跟着新页面重建），
    // 但离开文章页或视口收窄到移动端范围就强制回落。
    function refresh(animate) {
        bind();
        var target = stateFor(pendingUrl || location.href);
        if (current() === 'immersive' && target !== 'off' && immersiveAvailable()) target = 'immersive';
        setMode(target, animate === true);
    }

    function bind() {
        var btn = document.getElementById('immersive-btn');
        if (!btn || bound) return;
        bound = true;
        btn.addEventListener('click', function () {
            if (!VALID[current()]) return;
            next();
        });
    }

    // ---- swup 生命周期：优先用 swup 原生 hooks（时机最早，且能拿到目标 URL）----
    function setupSwup() {
        var swup = window.swup;
        if (!swup || !swup.hooks) return false;
        // 点链接、内容还没换时先记下目标 URL
        swup.hooks.on('visit:start', function (visit) {
            var to = visit && visit.to && (visit.to.url || visit.to);
            pendingUrl = typeof to === 'string' ? to : null;
        });
        swup.hooks.on('content:replace', function () { refresh(false); });
        swup.hooks.on('page:view', function () { refresh(false); });
        swup.hooks.on('visit:end', function () { refresh(false); pendingUrl = null; });
        return true;
    }

    window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && current() === 'immersive') next();
    });
    window.addEventListener('resize', function () {
        // 宽 → 窄：沉浸档不再可用，回落到默认档
        if (current() === 'immersive' && !immersiveAvailable()) setMode(DEFAULT_MODE, false);
        else { syncButton(); syncTocBtn(); }
    });

    // 供 ImmersiveReading（目录栏浮钮 / 标题条按钮）调用
    window.toggleImmersiveTOC = toggleToc;
    window.toggleReadingMode = next;
    window.setReadingMode = setMode;

    // 首屏：本脚本位于 grid 之前、同步执行，此时写入不会有闪烁
    setMode(stateFor(location.href), false);

    if (!setupSwup()) {
        document.addEventListener('swup:enable', setupSwup);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { refresh(false); });
    } else {
        refresh(false);
    }
    // 兜底：Astro 自己的页面加载事件（首屏与任何未被 swup hook 覆盖的情况）
    document.addEventListener('astro:page-load', function () { refresh(false); });
})();
</script>

<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Banner credit：把兜底文案换成当天的摄影师署名（数据来自自建 Worker 的 /meta） -->
<!-- Banner 在 Swup 容器之外，切页不重建，所以只需首次加载跑一次 -->
<script>
	(function () {
		const el = document.getElementById("banner-credit");
		const textEl = document.getElementById("banner-credit-text");
		if (!el || !textEl) return;
		const metaUrl = el.getAttribute("data-meta");
		if (!metaUrl) return;
		fetch(metaUrl)
			.then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
			.then((res) => {
				const d = res && res.data;
				if (!d) return;
				if (d.credit) textEl.textContent = d.credit;
				if (d.creditUrl) el.setAttribute("href", d.creditUrl);
			})
			.catch(() => {
				// 拿不到就保留兜底文案，不影响 banner 本身
			});
	})();
</script>

<!-- Main content -->
<div id="main-panel" class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" data-meta={bannerMetaUrl} target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div id="banner-credit-text" class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <!-- 侧栏可折叠标记：必须在 <main> 内部，才会跟着 swup 切页被替换。
                     详见本布局顶部脚本的 supportsCollapse()。 -->
                <div id="content-wrapper" class="onload-animation" data-sidebar-collapsible={sidebarCollapsible === true ? "true" : undefined}>
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

    </div>
</div>

<!-- 悬浮工具栏放在 main-grid 之外，避免祖先 transform 导致 fixed 定位失效 -->
<BackToTop></BackToTop>

<!-- 沉浸阅读：状态机 + 浮钮 + 全部沉浸态样式。同样必须落在 Swup 容器之外。 -->
<ImmersiveReading></ImmersiveReading>

<!-- The things that should be under the banner, only the TOC for now -->
<div id="toc-outer" class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            {/* 沉浸阅读：目录栏标题条。默认 display:none，仅沉浸态转 flex（样式在 ImmersiveReading.astro）。
                它位于 #toc-inner-wrapper 之外、#toc-wrapper 之内 —— 不属于 Swup 的替换目标（["main","#toc"]），
                切页不会重建，所以事件只绑一次即可。 */}
            <div id="immersive-toc-header">
                <span class="immersive-toc-title">{i18n(I18nKey.tocTitle)}</span>
                <button id="immersive-toc-close" type="button" class="immersive-toc-close" aria-label={i18n(I18nKey.tocCollapse)} title={i18n(I18nKey.tocCollapse)}>
                    <Icon name="material-symbols:chevron-left-rounded" class="immersive-toc-close-icon"></Icon>
                </button>
            </div>
            <div id="toc-inner-wrapper" class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>

<style is:global>
/* ================= 阅读模式 · 折叠与展开两档 =================
   状态统一由 <html data-sidebar="off|expanded|collapsed|immersive"> 单值驱动，
   该属性由上面的内联脚本在首屏绘制前同步写入（见脚本注释）。
   - collapsed  ：第一列收成 0，卡片吃满 --page-width，正文收进 --read-width（文章页默认）
   - expanded   ：用户手动展开
   - immersive  ：三档中最深的一档 —— 全部样式在 ImmersiveReading.astro（本文件不管）
   - off        ：本页不适用（首页 / 归档 / 关于 …），保持原双栏布局
   移动端（<1024px）本就是单列堆叠，不参与。 */

/* 阅读列宽度：折叠态下正文的量宽。
   50rem = 800px，**恰好等于展开态的量宽**（main 列 872 − 卡片左右内边距各 36px），
   所以折叠/展开切换时正文宽度不变、只是整列左右滑动，视觉上不突兀。
   想更窄就改这一个数字：46rem ≈ 46 汉字/行，42rem ≈ 42 汉字/行。 */
:root {
    --read-width: 50rem;
    /* 折叠态正文两侧的版心竖线：--guide-gap = 线离字面的距离，--guide-fade = 两端渐隐长度。
       两个数字就是全部的调节旋钮（颜色在下面那条规则里，跟 --primary 联动）。 */
    --guide-gap: 2.875rem;
    --guide-fade: 4rem;
}

@media (min-width: 1024px) {
    /* 栅格列宽变化默认不在 Tailwind 的 transition 属性列表里，这里显式声明 */
    #main-grid {
        transition: grid-template-columns 0.35s ease, column-gap 0.35s ease;
    }

    /* swup 切页时由脚本临时挂上 data-sidebar-noanim，两帧后移除，用来关掉过渡。
       切页是「整页换布局」：列宽与内边距都是容器宽度的函数，若在切换过程中逐帧插值，
       正文会来回重排 —— 既闪又卡，这正是「加载/切换变慢」的观感来源。
       手动点击折叠开关时不挂这个属性，过渡动画照常保留。 */
    html[data-sidebar-noanim] #main-grid,
    html[data-sidebar-noanim] #sidebar {
        transition: none !important;
    }

    html[data-sidebar="collapsed"] #main-grid {
        grid-template-columns: 0px auto;
        column-gap: 0;
    }

    /* 侧栏用 visibility 隐藏（保留栅格结构，不触发重排闪烁），
       折叠时先淡出 0.3s 再隐藏；展开时立即可见并淡入 */
    #sidebar {
        transition: opacity 0.3s ease, visibility 0s;
    }
    html[data-sidebar="collapsed"] #sidebar {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        overflow: hidden;
        min-width: 0;
        transition: opacity 0.3s ease, visibility 0s linear 0.3s;
    }

    /* ============ 折叠态：把正文收回阅读列并居中 ============
       注意这里收窄的是**卡片内部的文字列**，卡片外缘仍是 1168px，
       所以「卡片与顶栏等宽」这条对齐线不受影响。
       左右内边距 = (卡片宽 − 阅读列宽) / 2。padding 的百分比基准是包含块宽度
       （= #post-container 的父级宽度 = 正文列宽），所以 calc(100% - var(--read-width))
       除以 2 正好把富余宽度左右平分。
       max() 兜底：视口窄到算不出留白时（<848px，实际不会发生）退回 24px。
       特异性 (1,1,1) 高于 `md:px-9` 的 (0,1,0)，能正常覆盖。

       ⚠️ 这里**故意不给 padding 加 transition**。因为 padding 是「跟随容器宽度」算出来的，
       逐帧代入可得 正文量宽 = mainCol(t) − 2·padding(t) ≡ 800px —— 写成过渡反而会
       因为两端做插值而在动画中点鼓到 874px（文字来回重排）。不写过渡时它自己就是恒定的，
       而且这样也不会覆盖 .card-base 的 Tailwind transition（主题切换底色照常淡入）。 */
    html[data-sidebar="collapsed"] #post-container {
        /* 抽成变量：正文两侧的版心竖线要跟这条留白对齐，共用同一个表达式才不会错位 */
        --reading-gutter: max(1.5rem, calc((100% - var(--read-width)) / 2));
        padding-left: var(--reading-gutter);
        padding-right: var(--reading-gutter);
    }

    /* ============ 折叠态：正文两侧的版心竖线 ============
       折叠时卡片外缘仍是 1168px（保住与顶栏的对齐线），正文缩在中间的 800px 里，
       于是左右各 184px 的纯白就成了空档，文章看着"没东西框住"。
       这里在留白里、离字面 --guide-gap 处各补一条 1px 竖线，上下各渐隐 --guide-fade。

       三个刻意的取舍：
       ① 线只画在留白里，不进正文列 —— 不碰任何内容的层叠，也不会被正文里的
          代码块 / 引用块压住，更不用给内容加 z-index。
       ② 位置跟着 --reading-gutter 走，改 --read-width 时留白与竖线一起动。
       ③ 卡片自带 overflow:hidden，线用 top/bottom:0 顶格即可，两端渐隐后自然收干净。
       颜色用 20% 的主题色：比 --line-divider（黑/白 8%）略实一点，浅色暗色都看得见，
       且跟着主题色走 —— 想更淡改 transparent 的百分比就行。 */
    html[data-sidebar="collapsed"] #post-container::before,
    html[data-sidebar="collapsed"] #post-container::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        pointer-events: none;
        background: linear-gradient(
            to bottom,
            transparent 0,
            color-mix(in oklab, var(--primary), transparent 80%) var(--guide-fade),
            color-mix(in oklab, var(--primary), transparent 80%) calc(100% - var(--guide-fade)),
            transparent 100%
        );
    }
    html[data-sidebar="collapsed"] #post-container::before {
        left: calc(var(--reading-gutter) - var(--guide-gap));
    }
    html[data-sidebar="collapsed"] #post-container::after {
        right: calc(var(--reading-gutter) - var(--guide-gap));
    }
}

</style>
