---
import Comments from "@components/misc/Comments.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "../config";
import { friends } from "../friends_data";

// 每张卡片的主题色 tint（跟随主题 primary + 5 个固定色相轮换）
const TINTS = [
	"var(--primary)",
	"oklch(0.70 0.14 250)", // 蓝
	"oklch(0.72 0.14 330)", // 粉
	"oklch(0.70 0.13 165)", // 青
	"oklch(0.72 0.14 30)", // 橙
	"oklch(0.70 0.14 285)", // 紫
];

// 本站信息（一键复制用）
const SITE = import.meta.env.SITE;
const copyText = [
	`昵称：${siteConfig.title}`,
	`地址：${SITE}`,
	`头像：${SITE}/avatar.png`,
	`描述：${siteConfig.description}`,
	`RSS：${SITE}/rss.xml`,
].join("\n");
---

<MainGridLayout title="友情链接" description={siteConfig.description}>
    <div class="card-base p-6 md:p-8">

        <!-- 页头 -->
        <header class="mb-8">
            <div class="flex items-center gap-3 mb-3">
                <span class="w-1 h-5 bg-[var(--primary)] rounded-full"></span>
                <h1 class="text-xl font-semibold text-black dark:text-white">友情链接</h1>
            </div>
            <p class="text-sm text-black/55 dark:text-white/55">
                这些是我欣赏的创作者们，他们在各自的领域持续输出优质内容。
            </p>
        </header>

        <!-- Bento 友链卡片墙 -->
        <section class="mb-16">
            <div class="friends-bento-grid" data-friends-grid>
                {friends.map((friend, index) => (
                    <article
                        class="friend-bento-card"
                        data-friend-card
                        data-index={index}
                        style={`--friend-tint: ${TINTS[index % TINTS.length]}`}
                    >
                        <button type="button" class="friend-card-surface" aria-expanded="false" aria-label={`查看 ${friend.name} 的简介`}>
                            <span class="friend-card-media" aria-hidden="true">
                                <span class="friend-card-initial">{friend.name.charAt(0)}</span>
                                {friend.avatar && (
                                    <img src={friend.avatar} alt="" width="320" height="320" loading="lazy" decoding="async" onerror="this.remove()" />
                                )}
                            </span>
                            <span class="friend-card-shade" aria-hidden="true"></span>
                            <span class="friend-card-copy">
                                <span class="friend-card-name">{friend.name}</span>
                                <span class="friend-card-desc">{friend.description}</span>
                            </span>
                        </button>
                        {friend.url !== "#" && (
                            <a class="friend-card-link" href={friend.url} target="_blank" rel="noopener noreferrer" aria-label={`访问 ${friend.name}`} tabindex="-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                            </a>
                        )}
                    </article>
                ))}
            </div>
        </section>

        <!-- 申请友链 -->
        <section class="mb-12 space-y-6">
            <div class="flex items-center gap-3">
                <div class="icon-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-black dark:text-white">申请友链</h2>
                    <p class="text-sm text-black/55 dark:text-white/55">如果你也有一个持续更新的博客，欢迎互换友链</p>
                </div>
            </div>

            <div class="grid gap-6 lg:grid-cols-2">
                <div class="p-6 rounded-xl border border-[var(--line-color)]">
                    <h3 class="text-sm font-medium text-black dark:text-white mb-4">申请标准</h3>
                    <ul class="flex flex-col gap-3">
                        <li class="flex items-start gap-3 text-sm text-black/60 dark:text-white/60">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                            <span>贵站有一定深度的原创内容输出（读书笔记、专业研究、技术钻研或深度思考类内容）</span>
                        </li>
                        <li class="flex items-start gap-3 text-sm text-black/60 dark:text-white/60">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                            <span>内容以本人写作为主；AI 可用于查证、翻译、润色，但不接受整篇<strong class="font-semibold text-black dark:text-white">明显</strong>由 AI 生成或缺少个人思考与经验的批量内容</span>
                        </li>
                        <li class="flex items-start gap-3 text-sm text-black/60 dark:text-white/60">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                            <span>建站时间至少半年以上，且已有十篇以上的原创博文</span>
                        </li>
                        <li class="flex items-start gap-3 text-sm text-black/60 dark:text-white/60">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--primary)] mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                            <span>非以商业化为主，广告、推广内容不过多干扰阅读</span>
                        </li>
                    </ul>
                </div>
                <div class="p-6 rounded-xl border border-[var(--line-color)] relative">
                    <h3 class="text-sm font-medium text-black dark:text-white mb-4">本站信息</h3>
                    <button type="button" data-copy-all data-copy-text={copyText}
                        class="absolute right-6 top-6 inline-flex items-center gap-2 px-3 py-1.5 text-xs font-medium rounded-md border border-[var(--line-color)] hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors"
                        title="一键复制全部友链信息">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                        <span data-copy-label>复制全部</span>
                    </button>
                    <div class="space-y-3">
                        <div class="flex flex-col gap-1 sm:grid sm:grid-cols-[96px_1fr] sm:items-start sm:gap-x-4 sm:gap-y-1">
                            <span class="text-sm text-black/45 dark:text-white/45 shrink-0">站点名称</span>
                            <span class="text-sm text-black dark:text-white break-words">{siteConfig.title}</span>
                        </div>
                        <div class="flex flex-col gap-1 sm:grid sm:grid-cols-[96px_1fr] sm:items-start sm:gap-x-4 sm:gap-y-1">
                            <span class="text-sm text-black/45 dark:text-white/45 shrink-0">站点地址</span>
                            <span class="text-sm text-black dark:text-white break-words font-mono text-xs">{SITE}</span>
                        </div>
                        <div class="flex flex-col gap-1 sm:grid sm:grid-cols-[96px_1fr] sm:items-start sm:gap-x-4 sm:gap-y-1">
                            <span class="text-sm text-black/45 dark:text-white/45 shrink-0">站点头像</span>
                            <span class="text-sm text-black dark:text-white break-words font-mono text-xs">{SITE}/avatar.png</span>
                        </div>
                        <div class="flex flex-col gap-1 sm:grid sm:grid-cols-[96px_1fr] sm:items-start sm:gap-x-4 sm:gap-y-1">
                            <span class="text-sm text-black/45 dark:text-white/45 shrink-0">站点描述</span>
                            <span class="text-sm text-black dark:text-white break-words">{siteConfig.description}</span>
                        </div>
                        <div class="flex flex-col gap-1 sm:grid sm:grid-cols-[96px_1fr] sm:items-start sm:gap-x-4 sm:gap-y-1">
                            <span class="text-sm text-black/45 dark:text-white/45 shrink-0">RSS</span>
                            <span class="text-sm text-black dark:text-white break-words font-mono text-xs">{SITE}/rss.xml</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <Comments />

    </div>
</MainGridLayout>

<style>
/* ===== Bento 网格 ===== */
.friends-bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    grid-auto-rows: 132px;
    gap: 12px;
}

.friend-bento-card {
    border: 1px solid var(--line-color);
    background: var(--card-bg);
    border-radius: 20px;
    min-height: 0;
    position: relative;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s;
}

.friend-bento-card:hover,
.friend-bento-card.is-open,
.friend-bento-card:focus-within {
    z-index: 2;
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 16px 32px -14px rgba(0, 0, 0, 0.34);
}

.friend-card-surface {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    color: #fff;
}

.friend-card-surface:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -4px;
}

.friend-card-media,
.friend-card-shade {
    position: absolute;
    inset: 0;
}

.friend-card-media {
    background: color-mix(in oklab, var(--friend-tint), var(--card-bg) 72%);
}

.friend-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.25s;
}

/* 头像缺失/加载失败时显示首字母 */
.friend-card-initial {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    font-weight: 800;
    color: var(--friend-tint);
}

.friend-bento-card.is-featured .friend-card-initial {
    font-size: 48px;
}

/* 底部渐变遮罩 + 左下主题色光晕 */
.friend-card-shade {
    background:
        linear-gradient(to top, rgba(0, 0, 0, 0.76), rgba(0, 0, 0, 0.28) 46%, rgba(0, 0, 0, 0.04) 78%),
        radial-gradient(circle at 18% 85%, color-mix(in oklab, var(--friend-tint), transparent 54%), transparent 44%);
    transition: background 0.25s;
}

.friend-card-copy {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    flex-direction: column;
    gap: 0;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
}

.friend-card-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 12.5px;
    font-weight: 800;
    line-height: 1.25;
}

.friend-bento-card.is-featured .friend-card-copy {
    gap: 8px;
    bottom: 20px;
    left: 20px;
    right: 20px;
}

.friend-bento-card.is-featured .friend-card-name {
    font-size: 18px;
}

.friend-bento-card.is-wide .friend-card-name,
.friend-bento-card.is-tall .friend-card-name {
    font-size: 16px;
}

/* 描述默认隐藏，hover / 展开 / 聚焦时显现 */
.friend-card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    font-size: 11.5px;
    line-height: 1.5;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s;
}

.friend-bento-card.is-featured .friend-card-desc,
.friend-bento-card:hover .friend-card-desc,
.friend-bento-card.is-open .friend-card-desc,
.friend-bento-card:focus-within .friend-card-desc {
    max-height: 5.2em;
    opacity: 0.9;
    transform: none;
}

.friend-bento-card:hover .friend-card-copy,
.friend-bento-card.is-open .friend-card-copy,
.friend-bento-card:focus-within .friend-card-copy {
    gap: 6px;
}

.friend-bento-card.is-featured:hover .friend-card-copy,
.friend-bento-card.is-featured.is-open .friend-card-copy,
.friend-bento-card.is-featured:focus-within .friend-card-copy {
    gap: 8px;
}

.friend-bento-card:hover .friend-card-media img,
.friend-bento-card.is-open .friend-card-media img,
.friend-bento-card:focus-within .friend-card-media img {
    filter: saturate(0.9) brightness(0.72);
    transform: scale(1.1);
}

.friend-bento-card:hover .friend-card-shade,
.friend-bento-card.is-open .friend-card-shade,
.friend-bento-card:focus-within .friend-card-shade {
    background: linear-gradient(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.54) 42%, rgba(0, 0, 0, 0.86));
}

/* 右上角外链按钮（hover 时浮现） */
.friend-card-link {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: #111;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px) scale(0.82);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.22);
    transition: opacity 0.2s, transform 0.2s, background 0.2s;
}

.friend-card-link:hover {
    background: #fff;
    transform: translateY(0) scale(1.04);
}

.friend-bento-card:hover .friend-card-link,
.friend-bento-card.is-open .friend-card-link,
.friend-bento-card:focus-within .friend-card-link {
    opacity: 1;
    pointer-events: auto;
    transform: none;
}

/* 移动端：固定 2 列，取消悬浮位移 */
@media (max-width: 639px) {
    .friends-bento-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .friend-bento-card:hover {
        transform: none;
    }
}

@media (prefers-reduced-motion: reduce) {
    .friend-bento-card,
    .friend-card-media img,
    .friend-card-shade,
    .friend-card-desc,
    .friend-card-link {
        transition: none;
    }
}
</style>

<script>
// ===== Bento 布局引擎（移植自 lapis.cafe 友链页） =====
interface BentoItem {
  index: number;
  type: "small" | "large" | "wide" | "tall";
  x: number;
  y: number;
  w: number;
  h: number;
}

const shuffled = <T,>(items: T[]): T[] => {
  const result = [...items];
  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
};

const featuredCount = (count: number): number =>
  count < 7 ? 0 : Math.max(1, Math.round(count / 7));

const gridColumnCount = (grid: HTMLElement): number => {
  const gap = 12;
  const minTrack = 132;
  const width =
    grid.getBoundingClientRect().width ||
    Math.min(1180, Math.max(320, window.innerWidth - 48));
  return Math.max(2, Math.floor((width + gap) / (minTrack + gap)));
};

const shapePool = (count: number, columns: number): BentoItem[] => {
  const target = featuredCount(count);
  if (!target || columns < 4) return [];
  const wide = { type: "wide", w: 2, h: 1 } as BentoItem;
  const tall = { type: "tall", w: 1, h: 2 } as BentoItem;
  const large = { type: "large", w: 2, h: 2 } as BentoItem;
  if (columns < 5) return Array.from({ length: Math.min(target, 2) }, () => wide);
  if (target === 1) return [large];
  if (target === 2) return [large, wide];
  if (target === 3) return [large, wide, tall];
  if (target === 4) return [large, large, wide, tall];
  return [large, large, wide, wide, tall].slice(0, Math.min(target, 5));
};

const rectsOverlap = (a: BentoItem, b: BentoItem): boolean =>
  a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;

const placeFeatures = (
  assignments: BentoItem[],
  columns: number,
  count: number
): BentoItem[] | null => {
  const area = count + assignments.reduce((sum, item) => sum + item.w * item.h - 1, 0);
  const rows = Math.ceil(area / columns);
  const placed: BentoItem[] = [];
  for (const assignment of shuffled(assignments).sort((a, b) => b.w * b.h - a.w * a.h)) {
    const candidates: BentoItem[] = [];
    for (let y = 0; y <= rows - assignment.h; y++) {
      for (let x = 0; x <= columns - assignment.w; x++) {
        const candidate = { ...assignment, x, y };
        const startsLooseRow =
          x > 0 && !placed.some((item) => item.y <= y && item.y + item.h > y && item.x < x);
        if (startsLooseRow && y > rows * 0.45) continue;
        if (!placed.some((item) => rectsOverlap(item, candidate))) candidates.push(candidate);
      }
    }
    if (!candidates.length) return null;
    const lowerLine = rows * 0.48;
    const scored = candidates
      .map((candidate) => {
        const cx = candidate.x + candidate.w / 2;
        const cy = candidate.y + candidate.h / 2;
        const distance = placed.length
          ? Math.min(...placed.map((item) => Math.hypot(cx - (item.x + item.w / 2), cy - (item.y + item.h / 2))))
          : 0;
        let score = distance * 2.2 - candidate.y * 0.55 + Math.random() * 0.6;
        if (candidate.type === "large" && candidate.x + candidate.w >= columns) score -= 2.2;
        if (candidate.type === "large" && candidate.y > lowerLine) score -= 0.5;
        if (candidate.type === "wide" && candidate.y > lowerLine) score += 1.4;
        if (candidate.type === "wide" && candidate.x + candidate.w === columns) score -= 0.7;
        if (candidate.type === "tall" && candidate.y > lowerLine) score -= 3.4;
        if (candidate.type === "tall" && (candidate.x === 0 || candidate.x + candidate.w === columns)) score += 1.1;
        if (candidate.type === "tall" && candidate.x + candidate.w === columns && candidate.y <= lowerLine) score += 0.8;
        return { candidate, score };
      })
      .sort((a, b) => b.score - a.score);
    placed.push(scored[0].candidate);
  }
  return placed;
};

const buildGrid = (layout: BentoItem[], columns: number): boolean[][] => {
  const height = Math.max(...layout.map((item) => item.y + item.h), 1);
  const grid = Array.from({ length: height }, () => Array(columns).fill(false));
  layout.forEach((item) => {
    for (let y = item.y; y < item.y + item.h; y++) {
      for (let x = item.x; x < item.x + item.w; x++) grid[y][x] = true;
    }
  });
  return grid;
};

const fillSmallCards = (features: BentoItem[], smallIndexes: number[], columns: number): BentoItem[] => {
  const layout = [...features];
  let y = 0;
  let x = 0;
  const occupied = (px: number, py: number): boolean =>
    layout.some((item) => px >= item.x && px < item.x + item.w && py >= item.y && py < item.y + item.h);
  smallIndexes.forEach((index) => {
    while (occupied(x, y)) {
      x++;
      if (x >= columns) {
        x = 0;
        y++;
      }
    }
    layout.push({ index, type: "small", x, y, w: 1, h: 1 });
    x++;
    if (x >= columns) {
      x = 0;
      y++;
    }
  });
  return layout;
};

const scoreLayout = (layout: BentoItem[], columns: number): number => {
  const grid = buildGrid(layout, columns);
  const height = grid.length;
  const features = layout.filter((item) => item.type !== "small");
  let holes = 0;
  let emptyRows = 0;
  let leadingGaps = 0;
  let lowerLeadingGaps = 0;
  for (let y = 0; y < height; y++) {
    const row = grid[y];
    let lastFilled = -1;
    for (let x = row.length - 1; x >= 0; x--) {
      if (row[x]) {
        lastFilled = x;
        break;
      }
    }
    for (let x = 0; x < lastFilled; x++) if (!row[x]) holes++;
  }
  for (let y = 0; y < height - 1; y++) if (grid[y].every((cell) => !cell)) emptyRows++;
  grid.forEach((row, y) => {
    const firstFilled = row.findIndex(Boolean);
    if (firstFilled <= 0) return;
    leadingGaps += firstFilled;
    if (y > height * 0.55) lowerLeadingGaps += firstFilled;
  });
  const finalEmpty = grid[height - 1].filter((cell) => !cell).length;
  const lastSmallRow = Math.max(...layout.filter((item) => item.type === "small").map((item) => item.y), 0);
  const floatingFeature = features.filter((item) => item.y > lastSmallRow + 1).length;
  const featureDistance = features.reduce((sum, item, i) => {
    return (
      sum +
      features.slice(i + 1).reduce((part, other) => {
        return part + Math.hypot((item.x + item.w / 2) - (other.x + other.w / 2), (item.y + item.h / 2) - (other.y + other.h / 2));
      }, 0)
    );
  }, 0);
  const leftWeight = features.reduce((sum, item) => sum + (item.x + item.w / 2 < columns / 2 ? item.w * item.h : 0), 0);
  const rightWeight = features.reduce((sum, item) => sum + (item.x + item.w / 2 >= columns / 2 ? item.w * item.h : 0), 0);
  const balance = Math.abs(leftWeight - rightWeight);
  const badTall = features.filter((item) => item.type === "tall" && item.y > height * 0.48).length;
  const edgeLarge = features.filter((item) => item.type === "large" && item.x + item.w >= columns).length;
  return (
    featureDistance * 1.8 - holes * 11 - emptyRows * 80 - leadingGaps * 10 - lowerLeadingGaps * 16 -
    finalEmpty * 0.8 - height * 3.5 - balance * 0.9 - badTall * 10 - edgeLarge * 4 - floatingFeature * 90
  );
};

const createFeaturedAssignments = (count: number, columns: number): BentoItem[] => {
  const shapes = shapePool(count, columns);
  if (!shapes.length) return [];
  const indexes = shuffled(Array.from({ length: count }, (_, index) => index)).slice(0, shapes.length);
  return indexes.map((index, shapeIndex) => ({ ...shapes[shapeIndex], index }));
};

const normalizeAssignments = (assignments: BentoItem[], count: number, columns: number): BentoItem[] => {
  if (columns < 4) return [];
  const shapes = shapePool(count, columns);
  return assignments.slice(0, shapes.length).map((assignment, index) => ({
    ...shapes[index],
    index: assignment.index,
  }));
};

const buildBestLayout = (count: number, columns: number, assignments: BentoItem[]): Map<number, BentoItem> => {
  if (!assignments.length)
    return new Map(
      Array.from({ length: count }, (_, index) => [
        index,
        { index, type: "small", x: index % columns, y: Math.floor(index / columns), w: 1, h: 1 } as BentoItem,
      ])
    );

  let best: { layout: BentoItem[]; score: number } | null = null;
  for (let attempt = 0; attempt < 500; attempt++) {
    const featuredIndexes = assignments.map((item) => item.index);
    const smallIndexes = Array.from({ length: count }, (_, index) => index).filter(
      (index) => !featuredIndexes.includes(index)
    );
    const features = placeFeatures(assignments, columns, count);
    if (!features) continue;
    const layout = fillSmallCards(features, smallIndexes, columns);
    const score = scoreLayout(layout, columns);
    if (!best || score > best.score) best = { layout, score };
  }
  return new Map((best?.layout || []).map((item) => [item.index, item]));
};

// ===== 页面初始化（astro:page-load / swup 兼容） =====
let cleanups: (() => void)[] = [];

const setOpen = (card: HTMLElement, open: boolean): void => {
  const surface = card.querySelector<HTMLElement>(".friend-card-surface");
  const link = card.querySelector<HTMLAnchorElement>(".friend-card-link");
  card.classList.toggle("is-open", open);
  if (surface) surface.setAttribute("aria-expanded", open ? "true" : "false");
  if (link) link.tabIndex = open ? 0 : -1;
};

function initFriendsBento(): void {
  cleanups.forEach((cleanup) => cleanup());
  cleanups = [];

  const grid = document.querySelector<HTMLElement>("[data-friends-grid]");
  if (!grid) return;

  const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-friend-card]"));
  const initialColumns = gridColumnCount(grid);
  const featuredAssignments = createFeaturedAssignments(cards.length, Math.max(initialColumns, 7));
  const layoutCache = new Map<string, Map<number, BentoItem>>();
  let currentColumns = 0;

  const applyBentoLayout = (): void => {
    const columns = gridColumnCount(grid);
    if (columns === currentColumns) return;
    currentColumns = columns;

    const assignments = normalizeAssignments(featuredAssignments, cards.length, columns);
    const cacheKey = columns + ":" + assignments.map((item) => item.index + "-" + item.type).join("|");
    const layout = layoutCache.get(cacheKey) || buildBestLayout(cards.length, columns, assignments);
    layoutCache.set(cacheKey, layout);

    grid.style.gridTemplateColumns = "repeat(" + columns + ", minmax(0, 1fr))";
    cards.forEach((card, index) => {
      const item = layout.get(index);
      card.classList.remove("is-featured", "is-large", "is-wide", "is-tall", "is-open");
      if (!item) return;
      card.style.gridColumn = item.x + 1 + " / span " + item.w;
      card.style.gridRow = item.y + 1 + " / span " + item.h;
      if (item.type !== "small") card.classList.add("is-featured", "is-" + item.type);
      setOpen(card, false);
    });
  };

  cards.forEach((card) => {
    const surface = card.querySelector<HTMLElement>(".friend-card-surface");
    if (!surface) return;
    const clickHandler = (): void => {
      const willOpen = !card.classList.contains("is-open");
      cards.forEach((openCard) => setOpen(openCard, false));
      setOpen(card, willOpen);
    };
    const focusHandler = (): void => setOpen(card, true);
    surface.addEventListener("click", clickHandler);
    surface.addEventListener("focus", focusHandler);
    cleanups.push(() => surface.removeEventListener("click", clickHandler));
    cleanups.push(() => surface.removeEventListener("focus", focusHandler));
  });

  const documentClickHandler = (event: MouseEvent): void => {
    if ((event.target as HTMLElement).closest("[data-friend-card]")) return;
    cards.forEach((card) => setOpen(card, false));
  };
  document.addEventListener("click", documentClickHandler);
  cleanups.push(() => document.removeEventListener("click", documentClickHandler));

  let resizeTimer = 0;
  const resizeHandler = (): void => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(applyBentoLayout, 160);
  };
  window.addEventListener("resize", resizeHandler);
  cleanups.push(() => window.removeEventListener("resize", resizeHandler));

  applyBentoLayout();
}

// ===== 「复制全部」按钮 =====
function initCopyAll(): void {
  cleanups.forEach((cleanup) => cleanup());
  cleanups = [];

  const button = document.querySelector<HTMLButtonElement>("[data-copy-all]");
  if (!button) return;

  const label = button.querySelector<HTMLElement>("[data-copy-label]");
  const handler = async (): Promise<void> => {
    const text = button.getAttribute("data-copy-text") || "";
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      if (label) label.textContent = "已复制";
    } catch {
      if (label) label.textContent = "复制失败";
    }
    setTimeout(() => {
      if (label) label.textContent = "复制全部";
    }, 2000);
  };
  button.addEventListener("click", handler);
  cleanups.push(() => button.removeEventListener("click", handler));
}

function initFriendsPage(): void {
  initFriendsBento();
  initCopyAll();
}

document.addEventListener("astro:page-load", initFriendsPage);
document.addEventListener("swup:page:view", initFriendsPage);
</script>
